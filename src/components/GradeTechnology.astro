---
// The technology behind Grade, in plain words. Every claim here matches the
// Grade privacy policy (privacy/grade, privacy/grade-android): keep them in step.
const steps = [
  {
    title: "Capture on the device",
    body: "The app photographs each page on iPhone or iPad. Before anything leaves the device, Firebase App Check (with Apple App Attest, or Google Play Integrity on Android) confirms the request comes from a genuine copy of the app.",
  },
  {
    title: "Grade on Google Cloud",
    body: "Our grading service, hosted on Google Cloud in the United States, sends the pages to Google's Gemini model through Vertex AI with Matdo's grading instructions for the chosen mode: Brief, Detailed, or Essay.",
  },
  {
    title: "Return structured feedback",
    body: "Results come back as structured data, not a chat reply: the answer the student wrote, a mark, the correct answer, a worked solution, and the step where the working likely went wrong. Essays get rubric scores, paragraph notes and line-by-line fixes.",
  },
  {
    title: "Keep it private",
    body: "The app shows the marks on the student's own page. Our server keeps no copy of the pages or results, and neither we nor Google use them to train AI models. Saved checks stay on the device.",
  },
];
const stack = [
  "Gemini on Vertex AI",
  "Google Cloud (US)",
  "Firebase App Check",
  "Native iPhone & iPad app",
  "Android in testing",
];
---
<section id="technology" class="section-pad grade-tech" aria-labelledby="grade-tech-title">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="eyebrow">Technology</span>
      <h2 id="grade-tech-title">How Matdo Grade reads and grades a page</h2>
      <p>Matdo Grade is an AI grading service built on Google Cloud. It reads handwriting on a photographed page, grades each answer without an answer key, and explains the mistakes.</p>
    </div>
    <figure class="tech-flow reveal" aria-labelledby="tech-flow-caption">
      <figcaption id="tech-flow-caption" class="tech-sr-only">Pages travel from the app to Matdo's grading service, then to Gemini through Vertex AI with grading instructions. Structured feedback returns to the device.</figcaption>
      <div class="flow-path">
        <div class="flow-node flow-device">
          <svg class="node-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="6" y="5" width="27" height="36" rx="4"/><rect x="27" y="19" width="15" height="25" rx="3"/><path d="M16 35h7m10 3h3"/></svg>
          <h3>iPhone / iPad app</h3>
          <p>Capture a page</p>
        </div>
        <div class="flow-connector">
          <span class="flow-label">Pages</span>
          <svg class="flow-arrow" viewBox="0 0 100 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M0 12h96m-9-8 9 8-9 8"/></svg>
          <span class="app-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m12 2 8 3v6c0 5-8 10-8 10S4 16 4 11V5l8-3Z"/><path d="m8 11 3 3 5-6"/></svg>Firebase App Check</span>
          <small>Verifies the genuine app</small>
        </div>
        <div class="flow-node flow-service">
          <svg class="node-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M13 37a10 10 0 0 1-1-20 13 13 0 0 1 25-1 10.5 10.5 0 0 1-1 21H13Z"/><path d="M18 25h12m-12 5h12"/></svg>
          <h3>Matdo grading service</h3>
          <p>Google Cloud · United States</p>
          <span class="privacy-note">No copy kept · not used to train AI</span>
        </div>
        <div class="flow-connector">
          <span class="flow-label">Pages + grading instructions</span>
          <svg class="flow-arrow" viewBox="0 0 100 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M0 12h96m-9-8 9 8-9 8"/></svg>
          <small>Brief · Detailed · Essay</small>
        </div>
        <div class="flow-node flow-model">
          <svg class="node-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M24 5c0 12-7 19-19 19 12 0 19 7 19 19 0-12 7-19 19-19-12 0-19-7-19-19Z"/></svg>
          <h3>Gemini</h3>
          <p>Through Vertex AI</p>
        </div>
      </div>
      <div class="flow-return">
        <!-- Return path: a U drawn with borders (no stretched SVG), arrowhead pointing up at the device. -->
        <div class="return-path" aria-hidden="true">
          <svg class="return-head" viewBox="0 0 20 12" fill="none" stroke="currentColor" stroke-width="2"><path d="m2 11 8-9 8 9"/></svg>
        </div>
        <svg class="mobile-return-arrow" viewBox="0 0 24 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 0v44m-8-9 8 9 8-9"/></svg>
        <div class="return-label">
          <strong>Structured feedback <span>back to the device</span></strong>
          <p>Marks, answers, worked steps &amp; the likely mistake</p>
        </div>
      </div>
    </figure>
    <ol class="tech-steps" aria-label="How grading works in detail">
      {steps.map((s) => (
        <li class="reveal">
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
    <ul class="tech-stack reveal" aria-label="Built with">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
    <p class="tech-more reveal">Details on what is sent and kept: <a href="/privacy/grade/">Matdo Grade privacy policy</a>.</p>
  </div>
</section>

<style>
  #technology { scroll-margin-top: 100px; }
  .grade-tech .sec-head p { max-width: 44rem; margin-inline: auto; }
  .tech-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .tech-flow { margin: 0 0 36px; padding: 32px 24px 28px; border: 1px solid var(--color-line); border-radius: var(--radius); background: #f3eede; color: var(--color-forest); }
  .flow-path { display: grid; grid-template-columns: 1fr 0.7fr 1.3fr 0.7fr 1fr; gap: 12px; align-items: center; }
  .flow-node { min-width: 0; text-align: center; }
  .node-icon { width: 44px; height: 44px; margin: 0 auto 12px; color: #806123; }
  .flow-node h3 { margin: 0 0 6px; font-size: 1.2rem; line-height: 1.25; }
  .flow-node p { margin: 0; color: #4a5854; font-size: 0.88rem; line-height: 1.5; }
  .privacy-note { display: block; margin-top: 12px; color: #806123; font-size: 0.78rem; line-height: 1.5; font-weight: 600; }
  .flow-connector { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; min-width: 0; }
  .flow-label { font-size: 0.82rem; font-weight: 700; line-height: 1.4; }
  .flow-arrow { display: block; width: 100%; height: 24px; color: var(--color-forest); }
  .app-check { display: inline-flex; align-items: center; justify-content: center; gap: 4px; color: var(--color-teal); font-size: 0.75rem; font-weight: 700; line-height: 1.4; }
  .app-check svg { width: 20px; height: 24px; flex-shrink: 0; }
  .flow-connector small { color: #4a5854; font-size: 0.74rem; line-height: 1.4; }
  .flow-return { position: relative; margin-top: 8px; height: 112px; color: #806123; }
  /* Node centres sit at about 10.6% and 89.4% of the row (grid 1 / .7 / 1.3 / .7 / 1). */
  .return-path { position: absolute; inset: 0 10.6% 0 10.6%; border: 2px solid currentColor; border-top: 0; border-radius: 0 0 14px 14px; }
  .return-head { position: absolute; top: -3px; left: -11px; width: 20px; height: 12px; }
  .return-label { position: absolute; top: 18px; left: 22%; width: 56%; text-align: center; }
  .return-label strong { font-size: 0.95rem; }
  .return-label strong span { display: block; font-size: 0.78rem; font-weight: 500; }
  .return-label p { margin: 5px 0 0; color: #4a5854; font-size: 0.8rem; line-height: 1.5; }
  .mobile-return-arrow { display: none; }
  .tech-steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 36px; margin: 0; padding: 0; list-style: none; }
  .tech-steps li { min-width: 0; padding-top: 16px; border-top: 1px solid var(--color-line); }
  .tech-steps h3 { font-size: 1.25rem; margin: 0 0 8px; }
  .tech-steps p { margin: 0; color: #4a5854; font-size: 0.95rem; line-height: 1.6; }
  .tech-stack { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 32px 0 0; padding: 0; list-style: none; }
  .tech-stack li { padding: 6px 14px; border-radius: 999px; background: #f3eede; color: var(--color-forest); font-size: 0.88rem; font-weight: 600; }
  .tech-more { margin-top: 18px; text-align: center; font-size: 0.92rem; color: #55665f; }
  .tech-more a { color: #806123; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) {
    .tech-flow { padding: 24px 16px; }
    .flow-path { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .flow-node { width: 100%; max-width: 20rem; margin-inline: auto; }
    .flow-connector { display: grid; grid-template-columns: 1fr 24px 1fr; gap: 6px 12px; width: 100%; max-width: 20rem; margin-inline: auto; }
    .flow-label { grid-column: 1; grid-row: 1 / 3; text-align: right; }
    .flow-arrow { grid-column: 2; grid-row: 1 / 3; width: 64px; height: 24px; transform: rotate(90deg); justify-self: center; }
    .app-check { grid-column: 3; text-align: left; justify-content: flex-start; }
    .flow-connector small { grid-column: 3; text-align: left; }
    .flow-return { margin-top: 22px; min-height: 0; }
    .return-path { display: none; }
    .flow-return { height: auto; }
    .mobile-return-arrow { display: block; width: 24px; height: 48px; margin: 0 auto 14px; }
    .return-label { position: static; width: auto; padding: 16px 0 0; border-top: 1px solid #b08a3e; }
    .return-label strong span { margin-top: 4px; }
  }
  @media (max-width: 600px) { .tech-steps { grid-template-columns: 1fr; } }
</style>
