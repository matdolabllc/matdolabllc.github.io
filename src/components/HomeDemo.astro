  @media (max-width: 1080px) {
    .hd { grid-template-columns: minmax(0, 1fr); }
    .hd-jump { display: inline-block; margin-top: 20px; padding: 8px 16px; border-radius: 999px; background: #f6f0e0; border: 1px solid rgb(176 138 62 / 0.4); color: #806123; font-weight: 700; font-size: 0.92rem; }
  }
