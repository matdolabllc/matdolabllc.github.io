---
// The home page's hands-on hero: Check and Grade side by side, both live on load.
//
// Check: the kiosk ("front desk") and the Records dashboard, sharing one roster.
// The kiosk follows the app's own check-in/out flow (see the tutorial captions in
// public/demo/tutorials/check-in.vtt and check-out.vtt). Names are the app's demo roster.
// Grade: real Matdo Grade results, already graded. Pages, mark positions, answers
// and explanations all come from src/data/gradedSamples.ts (copied from the app).
import { APP_STORE_URL } from "../consts";
import { samples } from "../data/gradedSamples";
import { markPaths, placeEssayNotes, placeMarks } from "../lib/gradeMarks";

const show = (v: string, unit?: string) => (!unit ? v : unit === "$" ? `$${v}` : `${v} ${unit}`);

// Math: a Detailed-mode worksheet, with steps and "possible mistake" notes.
const mathS = samples.find((x) => x.id === "math")!;
const mPage = mathS.pages[0];
const mMarks = mPage.marks ?? [];
const mPlaced = placeMarks(mMarks.map((m) => m.box), mPage.width, mPage.height);
const mRows = mathS.rows ?? [];
const math = {
  page: mPage, alt: mathS.alt, seconds: mathS.seconds, mode: mathS.mode,
  correct: mRows.filter((r) => r.result === "correct").length,
  wrong: mRows.filter((r) => r.result === "incorrect").length,
  items: mMarks.map((m, i) => {
    const r = mRows.find((x) => x.n === m.n)!;
    return { n: m.n, result: m.result, q: mPlaced[i], student: show(r.student, r.unit), answer: show(r.correct, r.unit),
      why: r.explanation ?? "", steps: r.steps ?? [], mistakes: r.mistakes ?? [] };
  }),
};
const firstWrong = math.items.find((i) => i.result === "incorrect")?.n ?? math.items[0].n;
// The callout beside the first ✗: the app's verdict, readable without a tap.
const featured = math.items.find((i) => i.n === firstWrong)!;
const featuredTop = (featured.q.y / math.page.height) * 100;

// Writing: an Essay Mode result, with paragraph notes, fixes, rubric and comment.
const essayS = samples.find((x) => x.id === "essay")!;
const ePage = essayS.pages[0];
const eNotes = ePage.essayNotes ?? [];
const eSpots = placeEssayNotes(eNotes.map((n) => n.box), ePage.width, ePage.height);
const essay = {
  page: ePage, alt: essayS.alt, seconds: essayS.seconds, mode: essayS.mode, ...essayS.essay!,
  badges: eNotes.map((n, i) => ({
    n, sp: `s${i}`, view: n.kind === "paragraph" ? `p${n.index}` : "fixes",
    strong: n.kind === "paragraph" && n.isStrong,
    left: (eSpots[i].x / ePage.width) * 100, top: (eSpots[i].y / ePage.height) * 100,
    bw: ((1.7 * eSpots[i].size) / ePage.width) * 100,
    label: n.kind === "spelling" ? `${n.issue}: ${n.from}, should be ${n.to}` : `Paragraph ${n.index} note`,
  })),
};
const paragraphs = eNotes.flatMap((n) => (n.kind === "paragraph" ? [n] : []));
const fixes = eNotes.flatMap((n, i) => (n.kind === "spelling" ? [{ ...n, sp: `s${i}` }] : []));
const resultClass = (r: string) => (r === "Met" ? "ok" : r === "Not met" ? "bad" : "part");
const icons = {
  thumb: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 10h4v11H2zM8 10l4-8c1.7 0 3 1.3 3 3v4h5.5c1.1 0 2 1 1.8 2.1l-1.6 8.5c-.2.9-1 1.4-1.9 1.4H8z"/></svg>',
  bang: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9.6" y="2.5" width="4.8" height="13" rx="2.4"/><circle cx="12" cy="20" r="2.5"/></svg>',
};

const roster = [
  { last: "Bennett", first: "Clara", start: "in" },
  { last: "Harrison", first: "Anna", start: "done" },
  { last: "Lu", first: "Jason", start: "out" },
  { last: "Kennedy", first: "Charles", start: "out" },
  { last: "Smith", first: "Emily", start: "out" },
];
---
<!-- On a phone the panels stack; parents get a shortcut past the Check kiosk. -->
<a class="hd-jump" href="#hd-grade">Here for homework? Jump to Matdo Grade ↓</a>
<div class="hd" data-hd>
  <!-- ================= Matdo Check ================= -->
  <section class="hd-panel hd-check" aria-labelledby="hd-check-title">
    <header class="hd-head">
      <img src="/logos/matdo-check-mark.png" width="552" height="782" alt="" />
      <div>
        <h2 id="hd-check-title">Matdo Check</h2>
        <p>For tutoring center owners, managers and tutors. Works offline; pair iPads and iPhones.</p>
      </div>
      <a class="hd-more" href="/check/" aria-label="Learn more about Matdo Check">Learn more →</a>
    </header>

    <div class="hd-demo" data-desk>
      <div class="hd-bar">
        <div class="seg" role="group" aria-label="Demo screen">
          <button type="button" aria-pressed="true" data-view="kiosk">Front desk</button>
          <button type="button" aria-pressed="false" data-view="board">Dashboard</button>
        </div>
        <span class="hd-tag">Try it</span>
        <button type="button" class="hd-reset" data-reset>Start over</button>
      </div>

      <!-- Front desk (kiosk) -->
      <div class="view kiosk" data-pane="kiosk">
        <p class="k-prompt" data-prompt><span aria-hidden="true">👆</span> <span data-prompt-text>Jason is selected. Tap the green <b>Check In</b>.</span></p>
        <p class="k-clock"><b data-clock>&nbsp;</b><span data-date>&nbsp;</span></p>
        <p class="k-kicker">Attendee check-in</p>
        <h3 class="k-title">Who's here today?</h3>
        <label class="k-search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span class="sr">Search attendees</span>
          <input type="text" placeholder="Type first or last name…" autocomplete="off" spellcheck="false" data-search />
        </label>
        <ul class="k-results" data-results aria-label="Matching attendees"></ul>
        <p class="k-hint" data-hint>Try typing <button type="button" data-try="Lu">Lu</button> or <button type="button" data-try="Clara">Clara</button></p>
        <div class="k-actions">
          <button type="button" class="k-btn" data-act="in" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.6 2.7-6 6-6s6 2.4 6 6z"/><path d="m15 9 2 2 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span data-in-label>Check In</span>
          </button>
          <button type="button" class="k-btn" data-act="out" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 12V6.5a1.5 1.5 0 0 1 3 0V11m0-5.5V4.5a1.5 1.5 0 0 1 3 0V11m0-5.5a1.5 1.5 0 0 1 3 0V12m0-3.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1.5a6 6 0 0 1-5-2.7L3.7 14.6a1.5 1.5 0 0 1 2.4-1.8L7 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Check Out</span>
          </button>
        </div>
        <!-- The app's front desk has this row under Check In / Check Out. -->
        <div class="k-tools">
          <button type="button" data-kiosk-clear><span class="kt-ic" aria-hidden="true">↺ </span>Reset</button>
          <button type="button" disabled title="Not available in this demo" aria-label="Add Attendee (not available in this demo)"><span class="kt-ic" aria-hidden="true">＋ </span>Add Attendee</button>
          <button type="button" data-view-go="board"><span class="kt-ic" aria-hidden="true">▤ </span>Management</button>
        </div>
        <div class="k-done" data-done hidden>
          <span class="k-done-ic" aria-hidden="true">✓</span>
          <p data-done-text></p>
        </div>
      </div>

      <!-- Dashboard (Records) -->
      <div class="view board" data-pane="board" hidden>
        <p class="b-title">Attendance Dashboard <span data-today></span></p>
        <div class="b-counts">
          <div class="cnt in"><b data-count="in">1</b><span>In Class</span></div>
          <div class="cnt done"><b data-count="done">1</b><span>Already Done</span></div>
          <div class="cnt out"><b data-count="out">3</b><span>Not Present</span></div>
        </div>
        <ul class="b-rows" data-rows>
          {roster.map((r) => (
            <li class="b-row" data-name={`${r.first} ${r.last}`} data-last={r.last} data-first={r.first} data-start={r.start}>
              <div class="b-name"><b>{r.last}</b>, {r.first}<span class="b-when"></span></div>
              <button type="button" class="b-btn"></button>
            </li>
          ))}
        </ul>
      </div>
      <p class="sr" aria-live="polite" data-status></p>
    </div>

    <div class="hd-cta">
      <a class="btn btn-primary" href={APP_STORE_URL} rel="noopener">Try free on the App Store</a>
      <p class="hd-proof"><span class="stars" aria-hidden="true">★★★★★</span> <b>5.0</b> on the App Store · 5 ratings · 7-day free trial, then from $2.99/month</p>
      <p class="hd-proof">One plan covers every iPad and iPhone on your Apple Account · Records stay in your own iCloud</p>
    </div>
  </section>

  <!-- ================= Matdo Grade ================= -->
  <section class="hd-panel hd-grade" id="hd-grade" aria-labelledby="hd-grade-title">
    <header class="hd-head">
      <img src="/logos/matdo-grade-mark.png" width="552" height="782" alt="" />
      <div>
        <h2 id="hd-grade-title">Matdo Grade <span class="badge">Early access</span></h2>
        <p>For parents, tutors and teachers. Math, science, reading and essays. You review every mark.</p>
      </div>
      <a class="hd-more" href="/grade/" aria-label="Learn more about Matdo Grade">Learn more →</a>
    </header>

    <div class="hd-demo" data-grade>
      <div class="hd-bar">
        <div class="seg" role="group" aria-label="Graded example">
          <button type="button" aria-pressed="true" data-example="math">Math worksheet</button>
          <button type="button" aria-pressed="false" data-example="essay">Writing</button>
        </div>
        <span class="hd-tag">Real results</span>
      </div>

      <!-- ---------- Math ---------- -->
      <div class="gx" data-ex="math">
        <div class="gx-page">
          <div class="sheet" style={`aspect-ratio:${math.page.width} / ${math.page.height};--ar:${(math.page.width / math.page.height).toFixed(4)}`}>
            <img src={math.page.src} width={math.page.width} height={math.page.height} alt={math.alt} decoding="async" />
            <svg class="marks" viewBox={`0 0 ${math.page.width} ${math.page.height}`} aria-hidden="true">
              {math.items.map((m) => (
                <g class={`mark ${m.result}`} transform={`translate(${m.q.x.toFixed(1)} ${m.q.y.toFixed(1)})`}>
                  {markPaths(m.result, m.q.size).map((d) => <path d={d} stroke-width={(m.q.size * 0.17).toFixed(1)} />)}
                </g>
              ))}
            </svg>
            {math.items.map((m) => (
              <button type="button" class={`hit ${m.result}`} data-sel={`q${m.n}`} tabindex="-1" aria-hidden="true"
                style={`left:${((m.q.x / math.page.width) * 100).toFixed(2)}%;top:${((m.q.y / math.page.height) * 100).toFixed(2)}%`}></button>
            ))}
            <button type="button" class="callout" data-sel={`q${featured.n}`} style={`top:${featuredTop.toFixed(2)}%`}
              aria-label={`Question ${featured.n}: the student wrote ${featured.student}, the correct answer is ${featured.answer}. The decimal places were misaligned. Show details.`}>
              <span class="co-top"><span class="bad">✗ Q{featured.n}</span> <s>{featured.student}</s> → <b class="ok">{featured.answer}</b></span>
              <span class="co-why">Misaligned the decimal places</span>
              <span class="co-more">More ›</span>
            </button>
          </div>
          <p class="summary"><span class="ok">✓ {math.correct}</span><span class="bad">✗ {math.wrong}</span><span class="sum-note">{math.mode} · {math.seconds} s</span></p>
          <button type="button" class="show-detail" data-open aria-expanded="false" aria-controls="fb-math">Show Detail</button>
        </div>

        <div class="fb-card" id="fb-math" role="region" aria-label="Detailed grading" hidden>
          <div class="fb-top"><button type="button" class="fb-back" data-close>← Back to page</button><span class="fb-label">Grading Details</span></div>
          <div class="fb-scroll">
            <div class="fb-nav" role="group" aria-label="Questions">
              {math.items.map((m) => (
                <button type="button" data-sel={`q${m.n}`} aria-pressed={m.n === firstWrong ? "true" : "false"} class={m.result}>
                  {m.n}<span aria-hidden="true">{m.result === "correct" ? "✓" : "✗"}</span><span class="sr">{m.result === "correct" ? " correct" : " incorrect"}</span>
                </button>
              ))}
            </div>
            {math.items.map((m) => (
              <article class="fb" data-fb={`q${m.n}`} hidden={m.n !== firstWrong}>
                <div class="fb-head">
                  <h3>Question {m.n}</h3>
                  <span class={`chip ${m.result === "correct" ? "ok" : "bad"}`}>{m.result === "correct" ? "✓ Correct" : "✗ Incorrect"}</span>
                </div>
                {m.result === "correct" ? (
                  <dl class="fb-ans one"><div><dt>Answer</dt><dd class="ok">{m.student}</dd></div></dl>
                ) : (
                  <dl class="fb-ans"><div><dt>Student's answer</dt><dd class="bad">{m.student}</dd></div><div><dt>Correct answer</dt><dd class="ok">{m.answer}</dd></div></dl>
                )}
                {m.mistakes.length > 0 && (
                  <section class="fb-sec fb-mistake">
                    <h4>{m.mistakes.length > 1 ? "Possible mistakes" : "Possible mistake"}</h4>
                    {m.mistakes.map((x) => <p><b>{x.step === 0 ? "Overall" : `At step ${x.step}`}:</b> {x.detail}</p>)}
                  </section>
                )}
                {m.why && <section class="fb-sec"><h4>Why</h4><p>{m.why}</p></section>}
                {m.steps.length > 0 && (
                  <section class="fb-sec">
                    <h4>Worked solution</h4>
                    <ol class="fb-steps">
                      {m.steps.map((st) => <li>{st.text}{st.math && <code>{st.math}</code>}</li>)}
                    </ol>
                  </section>
                )}
              </article>
            ))}
          </div>
        </div>
      </div>

      <!-- ---------- Writing ---------- -->
      <div class="gx" data-ex="essay" hidden>
        <div class="gx-page">
          <div class="sheet" style={`aspect-ratio:${essay.page.width} / ${essay.page.height};--ar:${(essay.page.width / essay.page.height).toFixed(4)}`}>
            <img src={essay.page.src} width={essay.page.width} height={essay.page.height} alt={essay.alt} loading="lazy" decoding="async" />
            {essay.badges.map((b) => (
              <button type="button" class={`ebadge${b.strong ? " strong" : ""}`} data-sel={b.view} data-sp={b.n.kind === "spelling" ? b.sp : undefined}
                tabindex="-1" aria-hidden="true" title={b.label}
                style={`left:${b.left.toFixed(2)}%;top:${b.top.toFixed(2)}%;width:${b.bw.toFixed(2)}%`}
                set:html={b.strong ? icons.thumb : icons.bang} />
            ))}
          </div>
          <p class="summary"><span class="sum-mode">{essay.mode}</span><span class="sum-note">{fixes.length} fixes · {essay.seconds} s</span></p>
          <button type="button" class="show-detail" data-open aria-expanded="false" aria-controls="fb-essay">Show Detail</button>
        </div>

        <div class="fb-card" id="fb-essay" role="region" aria-label="Detailed feedback" hidden>
          <div class="fb-top"><button type="button" class="fb-back" data-close>← Back to page</button><span class="fb-label">Essay Feedback</span></div>
          <div class="fb-scroll">
            <div class="fb-nav" role="group" aria-label="Feedback">
              <button type="button" data-sel="overall" aria-pressed="true">Overall</button>
              {paragraphs.map((n) => <button type="button" data-sel={`p${n.index}`} aria-pressed="false">¶{n.index}</button>)}
              <button type="button" data-sel="fixes" aria-pressed="false">Fixes <span class="count">{fixes.length}</span></button>
            </div>

            <article class="fb" data-fb="overall">
              <div class="fb-head"><h3>Teacher-style feedback</h3></div>
              <p class="fb-comment">{essay.comment}</p>
              <section class="fb-sec">
                <h4>Rubric</h4>
                <ul class="rubric">
                  {essay.rubric.map((r) => (
                    <li><div class="rubric-top"><b>{r.title}</b><span class={`chip ${resultClass(r.result)}`}>{r.result}</span></div>{r.detail && <p>{r.detail}</p>}</li>
                  ))}
                </ul>
              </section>
            </article>

            {paragraphs.map((n) => (
              <article class="fb" data-fb={`p${n.index}`} hidden>
                <div class="fb-head"><h3>Paragraph {n.index}</h3><span class={`chip ${n.isStrong ? "ok" : "part"}`}>{n.isStrong ? "Strong" : "Needs work"}</span></div>
                <p class="fb-comment">{n.comment}</p>
              </article>
            ))}

            <article class="fb" data-fb="fixes" hidden>
              <div class="fb-head"><h3>Spelling and grammar</h3><span class="chip part">{fixes.length} fixes</span></div>
              <ul class="fixes">
                {fixes.map((f) => (
                  <li data-sp={f.sp}><span class="fix-issue">{f.issue}</span><span class="fix-change"><s>{f.from}</s> → <b>{f.to}</b></span></li>
                ))}
              </ul>
            </article>
          </div>
        </div>
      </div>
      <p class="sr" aria-live="polite" data-gstatus></p>
    </div>

    <div class="hd-cta">
      <a class="btn btn-primary btn-dark" href="/grade/try/">Join early access</a>
      <p class="hd-proof">Early access: about 100 pages free, on iPhone and iPad. Sign up and we'll reply within 48 hours.</p>
      <p class="hd-proof">Pages are sent for grading only. Matdo keeps no copy unless you send a problem report, and homework is never used to train AI.</p>
    </div>
  </section>
</div>

<style>
  .hd { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 36px; text-align: left; }
  .hd-panel { display: flex; flex-direction: column; gap: 16px; padding: 22px; border-radius: 20px; background: #fff; border: 1px solid var(--color-line); border-top: 4px solid var(--accent); box-shadow: var(--shadow-md); --accent: var(--color-teal); --tint: #edf3ee; }
  .hd-grade { --accent: #b08a3e; --tint: #f6f0e0; }
  .hd-head { display: flex; align-items: center; gap: 14px; }
  .hd-head img { height: 44px; width: auto; flex: none; }
  .hd-head h2 { font-size: 1.5rem; line-height: 1.15; display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .hd-head p { margin-top: 2px; font-size: 0.95rem; color: #34433e; }
  .hd-head > div { flex: 1; min-width: 0; }
  .hd-more { flex: none; align-self: flex-start; margin-top: 4px; font-size: 0.86rem; font-weight: 700; color: var(--accent); white-space: nowrap; }
  .hd-grade .hd-more { color: #806123; }
  .hd-more:hover { text-decoration: underline; text-underline-offset: 3px; }
  .hd-jump { display: none; }
  #hd-grade { scroll-margin-top: 90px; }
  .badge { padding: 2px 9px; border-radius: 999px; background: #b08a3e; color: #fff; font-family: var(--font-sans); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }

  /* Demo frame */
  .hd-demo { position: relative; flex: 1; display: flex; flex-direction: column; padding: 12px; border-radius: 14px; background: var(--tint); }
  .hd-bar { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
  .seg { display: inline-flex; padding: 3px; border-radius: 999px; background: #fff; border: 1px solid var(--color-line); min-width: 0; }
  .seg button { border: 0; background: transparent; border-radius: 999px; padding: 6px 12px; font: inherit; font-size: 0.84rem; font-weight: 600; color: #55665f; cursor: pointer; white-space: nowrap; }
  .seg button[aria-pressed="true"] { background: var(--color-forest); color: #fff; }
  .hd-tag { margin-left: auto; flex: none; padding: 4px 10px; border-radius: 999px; background: #fff; border: 1px solid currentColor; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--accent); }
  .hd-grade .hd-tag { color: #806123; }
  .hd-reset { flex: none; border: 1px solid var(--color-line); background: #fff; border-radius: 999px; padding: 5px 11px; font: inherit; font-size: 0.8rem; font-weight: 600; color: #3d4b47; cursor: pointer; }
  .seg button:focus-visible, .hd-reset:focus-visible, .k-btn:focus-visible, .b-btn:focus-visible, .fb-nav button:focus-visible, .k-results :global(button:focus-visible), .k-hint button:focus-visible { outline: 3px solid var(--color-mint); outline-offset: 2px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .view { position: relative; flex: 1; border-radius: 10px; background: #f2f2f7; padding: 16px; min-height: 380px; }
  .kiosk:not([hidden]) { display: flex; flex-direction: column; justify-content: center; }
  .view[hidden] { display: none; }

  /* Kiosk, after the app's front desk */
  .k-clock { display: grid; justify-items: center; line-height: 1.15; }
  .k-clock b { font-size: 1.05rem; color: #1c1c1e; }
  .k-clock span { font-size: 0.8rem; color: #55555a; }
  .k-kicker { margin-top: 18px; text-align: center; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #6f9a74; }
  .k-title { text-align: center; font-family: var(--font-sans); font-size: 1.45rem; font-weight: 700; color: #1c1c1e; margin: 2px 0 12px; }
  .k-search { display: flex; align-items: center; gap: 8px; padding: 0 12px; height: 46px; border-radius: 12px; background: #fff; box-shadow: 0 2px 10px rgb(0 0 0 / 0.06); color: #8e8e93; }
  .k-search svg { width: 18px; height: 18px; flex: none; }
  .k-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: 1rem; color: #1c1c1e; }
  .k-search:focus-within { box-shadow: 0 0 0 3px rgb(79 209 197 / 0.5); }
  .k-results { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 4px; }
