  /* Grade: the real page beside the app's feedback */
  .gx { position: relative; flex: 1; display: flex; flex-direction: column; }
  .gx[hidden] { display: none; }
  .gx-page { flex: 1; display: flex; flex-direction: column; align-items: center; }
  .sheet { position: relative; width: min(100%, calc(400px * var(--ar))); border-radius: 8px; overflow: hidden; background: #fff; box-shadow: var(--shadow-sm); }
  .sheet img { display: block; width: 100%; height: 100%; }
  /* The decimals photo is grey and dim; lift it so the marks stand out. Display only. */
  [data-ex="math"] .sheet img { filter: brightness(1.14) contrast(1.22) saturate(0.9); }
  .marks { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .mark path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .mark.correct path { stroke: #638c6d; }
  .mark.incorrect path { stroke: #f24e1e; }
  .hit { position: absolute; width: 30px; height: 30px; margin: -15px 0 0 -15px; border-radius: 50%; border: 0; background: transparent; cursor: pointer; }
  .hit:hover { background: rgb(29 59 52 / 0.1); }
  .hit[aria-pressed="true"] { box-shadow: 0 0 0 3px #ffb039; background: rgb(255 176 57 / 0.18); }
  /* Callout beside the first wrong answer, in the page's blank right margin */
  .callout { position: absolute; left: 51%; right: 2%; translate: 0 -50%; display: grid; gap: 2px; padding: 9px 12px; border: 1px solid rgb(242 78 30 / 0.35); border-radius: 10px; background: rgb(255 255 255 / 0.96); box-shadow: 0 6px 18px rgb(29 59 52 / 0.18); font: inherit; text-align: left; color: #1d2b27; cursor: pointer; }
  .callout::before { content: ""; position: absolute; left: -6px; top: 50%; width: 10px; height: 10px; translate: 0 -50%; rotate: 45deg; background: #fff; border-left: 1px solid rgb(242 78 30 / 0.35); border-bottom: 1px solid rgb(242 78 30 / 0.35); }
  .co-top { font-size: 0.95rem; line-height: 1.3; font-weight: 700; }
