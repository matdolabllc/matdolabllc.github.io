  .fixes li.on { border-color: #ffb039; background: #fff6e6; }
  .fix-issue { font-size: 0.76rem; color: #6b7772; }
  .fix-change { font-size: 0.92rem; }
  .fix-change s { color: #b23410; }
  .fix-change b { color: #3f6b48; }
  .ok { color: #4b7a55; } .bad { color: #c23a12; }

  /* Calls to action */
  .hd-cta { display: grid; gap: 6px; justify-items: start; }
  .hd-cta .btn { width: 100%; justify-content: center; }
  .btn-dark { background: #1a2422; box-shadow: 0 8px 20px rgb(26 36 34 / 0.22); }
  .btn-dark:hover { background: var(--color-forest); }
