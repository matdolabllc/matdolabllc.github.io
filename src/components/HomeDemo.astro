  .ebadge.strong { color: #638c6d; }
  .ebadge :global(svg) { width: 62%; height: 62%; fill: currentColor; }
  .ebadge[aria-pressed="true"] { border-color: #ffb039; box-shadow: 0 0 0 3px rgb(255 176 57 / 0.45); }
  .summary { display: flex; align-items: center; gap: 10px; width: min(100%, 360px); margin-top: 8px; padding: 6px 10px; border-radius: 10px; background: #fff; font-weight: 700; font-size: 0.92rem; }
  .sum-mode { color: #806123; white-space: nowrap; }
  .sum-note { margin-left: auto; font-weight: 500; font-size: 0.85rem; color: #4a5854; text-align: right; }

  .show-detail { width: min(100%, 360px); margin-top: 8px; min-height: 44px; border: 0; border-radius: 12px; background: #638c6d; color: #fff; font: inherit; font-weight: 700; font-size: 0.98rem; cursor: pointer; box-shadow: 0 6px 16px rgb(99 140 109 / 0.3); }
  .show-detail:hover { background: #557a5e; }
  .show-detail:focus-visible, .fb-back:focus-visible { outline: 3px solid var(--color-mint); outline-offset: 2px; }

  /* Detail view: opens over the page, inside the panel, so both panels keep their size */
  .fb-card { position: absolute; inset: 0; z-index: 3; display: flex; flex-direction: column; border-radius: 10px; background: #fff; box-shadow: var(--shadow-md); animation: fbin 0.22s ease-out; }
  .fb-card[hidden] { display: none; }
  @keyframes fbin { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .fb-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 12px; border-bottom: 1px solid var(--color-line); }
  .fb-back { border: 0; background: transparent; padding: 6px 8px; margin-left: -8px; border-radius: 8px; font: inherit; font-weight: 700; font-size: 0.9rem; color: var(--color-teal); cursor: pointer; }
  .fb-back:hover { background: var(--color-cream); }
  .fb-label { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #6b7772; }
  .fb-scroll { flex: 1; min-height: 0; overflow-y: auto; padding: 12px 14px 14px; overscroll-behavior: contain; }
  .fb-nav { display: flex; flex-wrap: wrap; gap: 5px; padding-bottom: 10px; margin-bottom: 10px; border-bottom: 1px solid var(--color-line); }
  .fb-nav button { display: inline-flex; align-items: center; gap: 3px; min-height: 30px; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--color-line); background: #fff; font: inherit; font-size: 0.8rem; font-weight: 600; color: #3d4b47; cursor: pointer; }
  .fb-nav button.correct span[aria-hidden] { color: #4b7a55; }
  .fb-nav button.incorrect span[aria-hidden] { color: #c23a12; }
  .fb-nav button[aria-pressed="true"] { background: var(--color-forest); border-color: var(--color-forest); color: #fff; }
  .fb-nav button[aria-pressed="true"] span[aria-hidden] { color: #fff; }
  .fb-nav .count { padding: 0 6px; border-radius: 999px; background: #ffb039; color: #1d2b27; font-size: 0.72rem; }
  .fb[hidden] { display: none; }
  .fb-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .fb-head h3 { font-family: var(--font-sans); font-size: 1rem; font-weight: 700; color: #1d2b27; }
  .chip { flex: none; padding: 2px 9px; border-radius: 999px; font-size: 0.74rem; font-weight: 700; }
  .chip.ok { background: #e6efe7; color: #3f6b48; }
  .chip.bad { background: #fde6dd; color: #b23410; }
  .chip.part { background: #fbf0dc; color: #8a5a12; }
  .fb-ans { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin: 0 0 10px; }
  .fb-ans.one { grid-template-columns: 1fr; }
  .fb-ans div { padding: 6px 9px; border-radius: 8px; background: #f6f6f3; }
  .fb-ans dt { font-size: 0.72rem; color: #6b7772; }
  .fb-ans dd { margin: 0; font-weight: 700; font-size: 1rem; word-break: break-word; }
  .fb-sec { margin-top: 10px; }
  .fb-sec h4 { font-family: var(--font-sans); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: #6b7772; margin-bottom: 4px; }
  .fb-sec p, .fb-comment { font-size: 0.88rem; line-height: 1.5; color: #2f3d39; }
  .fb-mistake { padding: 8px 10px; border-radius: 8px; background: #fff6e6; border-left: 3px solid #ffb039; }
  .fb-mistake p + p { margin-top: 4px; }
  .fb-steps { margin: 0; padding-left: 1.2rem; display: grid; gap: 6px; font-size: 0.86rem; line-height: 1.45; color: #2f3d39; }
  .fb-steps code { display: block; margin-top: 3px; padding: 4px 8px; border-radius: 6px; background: #f2f4f1; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.82rem; color: #1d2b27; white-space: pre-wrap; }
  .rubric { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .rubric li { padding: 8px 10px; border-radius: 8px; background: #f6f6f3; }
  .rubric-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 0.9rem; }
  .rubric p { margin-top: 3px; font-size: 0.84rem; line-height: 1.45; color: #3d4b47; }
