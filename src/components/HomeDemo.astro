</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-hd]");
  if (root) {
    const fmt = (d: Date) => d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
    // The demo runs on an after-school clock: it starts at 3:45 PM today and moves with real time,
    // so the front desk never shows "11:11 PM" to a late-night visitor.
    const demoStart = new Date(); demoStart.setHours(15, 45, 0, 0);
    const loadedAt = Date.now();
    const demoNow = () => new Date(demoStart.getTime() + (Date.now() - loadedAt));
    const ago = (min: number) => fmt(new Date(demoNow().getTime() - min * 60000));
    const toMin = (s: string) => { const [, h, m, ap] = s.match(/(\d+):(\d+)\s*(AM|PM)/i) ?? []; return ((Number(h) % 12) + (/pm/i.test(ap ?? "") ? 12 : 0)) * 60 + Number(m); };
    const mins = (a: string, b: string) => { const m = toMin(b) - toMin(a); return Number.isFinite(m) ? (m + 1440) % 1440 : 0; };

    /* ================= Check ================= */
    const desk = root.querySelector<HTMLElement>("[data-desk]")!;
    const status = desk.querySelector<HTMLElement>("[data-status]")!;
    const say = (t: string) => { status.textContent = t; };
    type Person = { name: string; last: string; first: string; start: string; state: string; in: string; out: string };
    const people: Person[] = [...desk.querySelectorAll<HTMLElement>(".b-row")].map((r) => ({
      name: r.dataset.name!, last: r.dataset.last!, first: r.dataset.first!, start: r.dataset.start!, state: "", in: "", out: "",
    }));
    // Times are relative to the visitor's clock, so every duration makes sense.
    const seed = () => people.forEach((p) => {
      p.state = p.start;
      p.in = p.start === "in" ? ago(25) : p.start === "done" ? ago(90) : "";
      p.out = p.start === "done" ? ago(35) : "";
    });

    // Clock and date, like the kiosk header.
    const tick = () => {
      const d = demoNow();
      desk.querySelector("[data-clock]")!.textContent = fmt(d);
      desk.querySelector("[data-date]")!.textContent = d.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" });
      desk.querySelector("[data-today]")!.textContent = d.toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" });
    };
    tick(); setInterval(tick, 20000);

    // Front desk / Dashboard
    const views = [...desk.querySelectorAll<HTMLButtonElement>("[data-view]")];
    const show = (v: string) => {
      views.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.view === v)));
      desk.querySelectorAll<HTMLElement>("[data-pane]").forEach((p) => (p.hidden = p.dataset.pane !== v));
    };
    views.forEach((b) => b.addEventListener("click", () => show(b.dataset.view!)));

    // Dashboard
    const renderBoard = () => {
      const counts: Record<string, number> = { in: 0, done: 0, out: 0 };
      desk.querySelectorAll<HTMLElement>(".b-row").forEach((row, i) => {
        const p = people[i];
        counts[p.state]++;
        row.className = `b-row ${p.state}`;
        const when = row.querySelector<HTMLElement>(".b-when")!;
        const btn = row.querySelector<HTMLButtonElement>(".b-btn")!;
        if (p.state === "out") { when.textContent = "Not in yet"; btn.textContent = "Check In"; btn.disabled = false; btn.setAttribute("aria-label", `Check in ${p.name}`); }
        if (p.state === "in") { when.textContent = `In at ${p.in}`; btn.textContent = "Check Out"; btn.disabled = false; btn.setAttribute("aria-label", `Check out ${p.name}`); }
        if (p.state === "done") { when.textContent = `${p.in} – ${p.out} · ${mins(p.in, p.out)} min`; btn.textContent = "Done"; btn.disabled = true; btn.removeAttribute("aria-label"); }
      });
      for (const k in counts) desk.querySelector(`[data-count="${k}"]`)!.textContent = String(counts[k]);
    };
    const act = (p: Person) => {
      if (p.state === "out") { p.state = "in"; p.in = fmt(demoNow()); return `${p.name} checked in at ${p.in}.`; }
      if (p.state === "in") { p.state = "done"; p.out = fmt(demoNow()); return `${p.name} checked out at ${p.out}.`; }
      return "";
    };
    desk.querySelector("[data-rows]")!.addEventListener("click", (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>(".b-btn");
      if (!btn || btn.disabled) return;
      const i = [...desk.querySelectorAll(".b-btn")].indexOf(btn);
      say(act(people[i]));
      renderBoard();
      renderResults();
    });

    // Kiosk: type → pick a name → the ready button turns green → tap it.
    const search = desk.querySelector<HTMLInputElement>("[data-search]")!;
    const results = desk.querySelector<HTMLElement>("[data-results]")!;
    const hint = desk.querySelector<HTMLElement>("[data-hint]")!;
    const inBtn = desk.querySelector<HTMLButtonElement>('[data-act="in"]')!;
    const outBtn = desk.querySelector<HTMLButtonElement>('[data-act="out"]')!;
    const inLabel = desk.querySelector<HTMLElement>("[data-in-label]")!;
    const done = desk.querySelector<HTMLElement>("[data-done]")!;
    let picked: Person | null = null;
    let doneTimer = 0;

    const renderButtons = () => {
      inBtn.className = "k-btn"; outBtn.className = "k-btn";
      inBtn.disabled = outBtn.disabled = true;
      inLabel.textContent = "Check In";
      if (!picked) return;
      if (picked.state === "out") { inBtn.classList.add("ready"); inBtn.disabled = false; }
      else { inBtn.classList.add("finished"); inLabel.textContent = `In ${picked.in}`; }
      if (picked.state === "in") { outBtn.classList.add("ready"); outBtn.disabled = false; }
    };
    function renderResults() {
      const q = search.value.trim().toLowerCase();
      results.innerHTML = "";
      hint.hidden = q.length > 0;
      if (!q) { picked = null; renderButtons(); return; }
      const hits = people.filter((p) => p.first.toLowerCase().includes(q) || p.last.toLowerCase().includes(q));
      if (!hits.includes(picked!)) picked = null;
      for (const p of hits) {
        const li = document.createElement("li");
        const b = document.createElement("button");
        b.type = "button";
        b.setAttribute("aria-pressed", String(p === picked));
        const name = document.createElement("span");
        name.textContent = `${p.first} ${p.last}`;
        const note = document.createElement("small");
        note.textContent = p.state === "in" ? `In since ${p.in}` : p.state === "done" ? "Done for today" : "Not in yet";
        b.append(name, note);
        b.addEventListener("click", () => { picked = p; renderResults(); say(`${p.name} selected.`); (p.state === "out" ? inBtn : outBtn).focus({ preventScroll: true }); });
        li.append(b);
        results.append(li);
      }
      if (!hits.length) {
        const li = document.createElement("li");
        li.className = "k-none";
        li.textContent = "No match in this demo roster.";
        results.append(li);
      }
      renderButtons();
    }
    search.addEventListener("input", renderResults);
    // Kiosk Reset clears the search (as in the app); Management opens the dashboard.
    desk.querySelector("[data-kiosk-clear]")!.addEventListener("click", () => {
      search.value = ""; picked = null; renderResults(); search.focus({ preventScroll: true });
    });
    desk.querySelector("[data-view-go]")!.addEventListener("click", () => show("board"));
    desk.querySelectorAll<HTMLButtonElement>("[data-try]").forEach((b) => b.addEventListener("click", () => {
      search.value = b.dataset.try!; renderResults(); search.focus({ preventScroll: true });
    }));
    const promptText = desk.querySelector<HTMLElement>("[data-prompt-text]")!;
    const setPrompt = (html: string) => { promptText.innerHTML = html; };
    const finish = (msg: string) => {
      desk.querySelector("[data-done-text]")!.textContent = msg;
      done.hidden = false;
      say(msg);
      renderBoard();
      clearTimeout(doneTimer);
      // As in the app: the kiosk returns on its own, ready for the next person.
      setPrompt("Now type another name, or open the <b>Dashboard</b>.");
      doneTimer = window.setTimeout(() => {
        done.hidden = true; search.value = ""; picked = null; renderResults();
        search.focus({ preventScroll: true });
      }, 2200);
    };
    inBtn.addEventListener("click", () => { if (picked && picked.state === "out") finish(act(picked)); });
    outBtn.addEventListener("click", () => { if (picked && picked.state === "in") finish(act(picked)); });

    desk.querySelector("[data-reset]")!.addEventListener("click", () => {
      clearTimeout(doneTimer); done.hidden = true;
      seed(); search.value = ""; picked = null; renderResults(); renderBoard(); say("Demo reset.");
      setPrompt("Type a name, tap it, then tap the green button.");
    });
    seed(); renderBoard();
    // Start ready to try: one attendee found and selected, Check In already green.
    search.value = "Jason";
    renderResults();
    picked = people.find((p) => p.first === "Jason") ?? null;
    renderResults();

    /* ================= Grade ================= */
    const grade = root.querySelector<HTMLElement>("[data-grade]")!;
    const gsay = (t: string) => { grade.querySelector("[data-gstatus]")!.textContent = t; };
    const exButtons = [...grade.querySelectorAll<HTMLButtonElement>("[data-example]")];
    exButtons.forEach((b) => b.addEventListener("click", () => {
      exButtons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      grade.querySelectorAll<HTMLElement>(".fb-card").forEach((c) => (c.hidden = true));
      grade.querySelectorAll("[data-open]").forEach((o) => o.setAttribute("aria-expanded", "false"));
      grade.querySelectorAll<HTMLElement>("[data-ex]").forEach((ex) => (ex.hidden = ex.dataset.ex !== b.dataset.example));
    }));
    // One selection per example: the nav chip, the mark or badge on the page,
    // and the feedback shown beside it all follow it.
    const select = (ex: HTMLElement, id: string, sp?: string, quiet = false) => {
      ex.querySelectorAll<HTMLElement>("[data-fb]").forEach((f) => (f.hidden = f.dataset.fb !== id));
      ex.querySelectorAll<HTMLElement>(".fb-nav [data-sel]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.sel === id)));
      ex.querySelectorAll<HTMLElement>(".sheet [data-sel]").forEach((b) =>
        b.setAttribute("aria-pressed", String(sp ? b.dataset.sp === sp : b.dataset.sel === id && !b.dataset.sp)));
      ex.querySelectorAll<HTMLElement>(".fixes li").forEach((li) => li.classList.toggle("on", !!sp && li.dataset.sp === sp));
      const scroller = ex.querySelector<HTMLElement>(".fb-scroll")!;
      const target = sp ? ex.querySelector<HTMLElement>(`.fixes li[data-sp="${sp}"]`) : null;
      if (target) target.scrollIntoView({ block: "nearest" }); else scroller.scrollTop = 0;
      const shown = ex.querySelector<HTMLElement>(`[data-fb="${id}"] h3`);
      if (!quiet) gsay(shown ? `${shown.textContent} feedback shown.` : "");
    };
    // Show Detail (or a mark on the page) opens the detail view over the page.
    const openDetail = (ex: HTMLElement) => {
      const card = ex.querySelector<HTMLElement>(".fb-card")!;
      card.hidden = false;
      ex.querySelector("[data-open]")!.setAttribute("aria-expanded", "true");
      card.querySelector<HTMLElement>("[data-close]")!.focus({ preventScroll: true });
    };
    const closeDetail = (ex: HTMLElement) => {
      const card = ex.querySelector<HTMLElement>(".fb-card")!;
      if (card.hidden) return;
      card.hidden = true;
      const opener = ex.querySelector<HTMLElement>("[data-open]")!;
      opener.setAttribute("aria-expanded", "false");
      opener.focus({ preventScroll: true });
    };
    grade.querySelectorAll<HTMLElement>("[data-ex]").forEach((ex) => {
      ex.addEventListener("click", (e) => {
        const t = e.target as Element;
        if (t.closest("[data-open]")) { openDetail(ex); return; }
        if (t.closest("[data-close]")) { closeDetail(ex); return; }
        const b = t.closest<HTMLElement>("[data-sel]");
        if (!b) return;
        select(ex, b.dataset.sel!, b.dataset.sp);
        if (b.closest(".sheet")) openDetail(ex);
      });
      ex.addEventListener("keydown", (e) => { if (e.key === "Escape") closeDetail(ex); });
      const first = ex.querySelector<HTMLElement>('.fb-nav [aria-pressed="true"]');
      if (first) select(ex, first.dataset.sel!, undefined, true);
    });
  }
</script>
