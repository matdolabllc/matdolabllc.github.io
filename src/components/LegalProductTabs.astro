---
interface Props {
  product: "check" | "grade";
  document: "privacy" | "terms" | "support";
}

const { product, document } = Astro.props;
const products = [
  { id: "check", label: "Matdo Check", href: `/${document}/check` },
  { id: "grade", label: "Matdo Grade", href: `/${document}/grade` },
];
---

<nav class="legal-product-tabs" aria-label={`Product ${document === "privacy" ? "privacy policies" : document === "terms" ? "terms of use" : "support"}`}>
  {products.map(({ id, label, href }) => (
    <a href={href} aria-current={product === id ? "page" : undefined}>{label}</a>
  ))}
</nav>

<style>
  .legal-product-tabs {
    display: flex;
    gap: 8px;
    border-bottom: 1px solid var(--color-line);
    margin: 0 0 24px;
  }
  a {
    flex: 1;
    text-align: center;
    padding: 12px 16px;
    border-bottom: 3px solid transparent;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    color: #55665f;
    font-weight: 600;
    text-decoration: none;
  }
  a:hover { background: #f0f4f1; color: var(--color-forest); }
  a[aria-current="page"] {
    color: var(--color-forest);
    background: #f0f4f1;
    border-bottom-color: var(--color-teal);
  }
  a:focus-visible { outline: 2px solid var(--color-teal); outline-offset: 3px; }
  @media print { .legal-product-tabs { display: none; } }
</style>
