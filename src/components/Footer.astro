---
import Logo from "./Logo.astro";
import { SOCIAL_LINKS } from "../consts";
const year = 2026;

// Simple-icons style glyphs (24x24), drawn in currentColor.
const icons: Record<string, string> = {
  LinkedIn: "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z",
  Facebook: "M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07z",
  Instagram: "M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.13 1.38A5.88 5.88 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13a5.88 5.88 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.88 5.88 0 0 0 2.13-1.38 5.88 5.88 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.88 5.88 0 0 0-1.38-2.13A5.88 5.88 0 0 0 19.86.63C19.1.33 18.22.13 16.95.07 15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z",
};

// Keep support and legal links aligned with the current product.
const isGrade = /^\/grade(\/|$)/.test(Astro.url.pathname)
  || /^\/(privacy|terms|support)\/grade\/?$/.test(Astro.url.pathname);
const product = isGrade ? "grade" : "check";
const support = `/support/${product}`;
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <Logo class="foot-brand" />
        <p class="foot-tag">Less admin. More teaching.</p>
        <div class="foot-social">
          {SOCIAL_LINKS.map((s) => (
            <a href={s.url} target="_blank" rel="noopener me" aria-label={`Matdo on ${s.name}`} title={s.name} class={`soc-${s.name.toLowerCase()}`}>
              <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d={icons[s.name]} /></svg>
            </a>
          ))}
        </div>
      </div>
      <div class="foot-col">
        <h5>Products</h5>
        <a href="/check">Matdo Check</a>
        <a href="/grade">Matdo Grade</a>
      </div>
      <div class="foot-col">
        <h5>Company</h5>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href={support}>Support</a>
        <a href={`/privacy/${product}`}>Privacy</a>
        <a href={`/terms/${product}`}>Terms</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year} Matdo Lab LLC.</span>
      <span>Made with care for educators.</span>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--color-forest); color: #d9e3df; padding: 64px 0 32px; }
  .foot-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 40px; margin-bottom: 3rem; }
  footer :global(.foot-brand) { color: #fff; margin-bottom: 0.9rem; --logo-pocket: var(--color-cream); }
  .foot-tag { color: rgb(255 255 255 / 0.7); max-width: 22rem; font-size: 0.96rem; margin-top: 0.9rem; }
  /* Each network in its own brand colour, white glyph on top. */
  .foot-social { display: flex; gap: 0.8rem; margin-top: 1.4rem; }
  .foot-social a { display: inline-flex; align-items: center; justify-content: center; width: 52px; height: 52px; border-radius: 999px; color: #fff; box-shadow: 0 2px 8px rgb(0 0 0 / 0.25); transition: transform 0.2s, box-shadow 0.2s; }
  .foot-social a:hover { transform: translateY(-2px) scale(1.06); box-shadow: 0 6px 16px rgb(0 0 0 / 0.3); }
  .foot-social .soc-linkedin { background: #0a66c2; }
  .foot-social .soc-facebook { background: #1877f2; }
  .foot-social .soc-instagram { background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285aeb 90%); }
  @media (prefers-reduced-motion: reduce) { .foot-social a:hover { transform: none; } }
  .foot-col h5 { font-family: var(--font-sans); font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-mint); margin: 0 0 1rem; font-weight: 700; }
  .foot-col a { display: block; color: rgb(255 255 255 / 0.78); padding: 0.35rem 0; font-size: 0.95rem; transition: color 0.2s, padding-left 0.2s; }
  .foot-col a:hover { color: #fff; padding-left: 4px; }
  .foot-soon { display: inline-flex; align-items: center; gap: 0.5rem; color: rgb(255 255 255 / 0.5); font-size: 0.95rem; padding: 0.35rem 0; }
  .foot-soon .soon-tag { font-size: 0.56rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #08130d; background: var(--color-mint); padding: 1px 6px; border-radius: 999px; }
  .foot-bottom { border-top: 1px solid rgb(255 255 255 / 0.12); padding-top: 1.8rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; font-size: 0.86rem; color: rgb(255 255 255 / 0.6); }

  @media (max-width: 900px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .foot-grid { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    footer { padding-top: 48px; }
    .foot-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; margin-bottom: 2rem; }
    .foot-grid > :first-child { grid-column: 1 / -1; }
    .foot-col a { display: flex; align-items: center; min-height: 44px; }
    .foot-bottom { flex-direction: column; gap: 8px; }
  }
</style>
