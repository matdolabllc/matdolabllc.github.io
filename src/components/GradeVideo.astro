---
// One player: selecting a variant loads only that variant's video resources.
const desktop = {
  webm: '/demo/matdo-grade-film.webm?v=20261004-v4',
  mp4: '/demo/matdo-grade-film.mp4?v=20261004-v4',
  poster: '/demo/matdo-grade-film-poster.jpg?v=20261004-v4',
  captions: '/demo/matdo-grade-film.vtt?v=20261004-v4',
};
const mobile = {
  webm: '/demo/matdo-grade-film-mobile.webm?v=20261004-mobile-v1',
  mp4: '/demo/matdo-grade-film-mobile.mp4?v=20261004-mobile-v1',
  poster: '/demo/matdo-grade-film-mobile-poster.jpg?v=20261004-mobile-v1',
  captions: '/demo/matdo-grade-film-mobile.vtt?v=20261004-mobile-v1',
};
---
<figure class="video-frame reveal grade-film">
  <video class="demo-video" controls autoplay muted loop playsinline preload="metadata"
    width="1280" height="720" aria-label="Matdo Grade introduction film"
    data-desktop-poster={desktop.poster} data-mobile-poster={mobile.poster}>
    <source type="video/webm" data-desktop-src={desktop.webm} data-mobile-src={mobile.webm} />
    <source type="video/mp4" data-desktop-src={desktop.mp4} data-mobile-src={mobile.mp4} />
    <track kind="captions" srclang="en" label="English"
      data-desktop-src={desktop.captions} data-mobile-src={mobile.captions} />
    Your browser can't play embedded video — <a href={desktop.mp4}>watch it here</a>.
  </video>
  <noscript><a href={desktop.mp4}>Watch the Matdo Grade introduction film</a>.</noscript>
</figure>

<script is:inline>
  (() => {
    const figure = document.currentScript.previousElementSibling;
    const video = figure.querySelector('video');
    const sources = [...video.querySelectorAll('source')];
    let track = video.querySelector('track');
    const fallback = video.querySelector('a');
    const media = matchMedia('(max-width: 760px)');
    let variant;
    let revision = 0;
    let fullscreen = false;
    let metadataListener;
    let desired = media.matches ? 'mobile' : 'desktop';

    function select(next) {
      desired = next;
      if (variant === next || fullscreen || document.fullscreenElement === video || video.webkitDisplayingFullscreen) return;
      const first = !variant;
      const time = first ? 0 : video.currentTime;
      const playing = first ? video.autoplay : !video.paused && !video.ended;
      const captions = video.textTracks[0]?.mode === 'showing';
      const currentRevision = ++revision;
      if (metadataListener) video.removeEventListener('loadedmetadata', metadataListener);
      video.pause();
      // An explicit user pause wins over autoplay when rotating the phone.
      video.autoplay = false;
      variant = next;
      video.dataset.variant = next;
      video.width = next === 'mobile' ? 1080 : 1280;
      video.height = next === 'mobile' ? 1350 : 720;
      video.poster = video.dataset[next + 'Poster'];
      sources.forEach(source => source.src = source.dataset[next + 'Src']);
      // Replace the track so cues from the previous film cannot linger.
      const newTrack = track.cloneNode(false);
      if (track.track) track.track.mode = 'disabled';
      newTrack.src = track.dataset[next + 'Src'];
      track.replaceWith(newTrack);
      track = newTrack;
      fallback.href = sources[1].src;
      metadataListener = () => {
        if (currentRevision !== revision) return;
        if (time > 0 && Number.isFinite(video.duration)) video.currentTime = Math.min(time, video.duration - .05);
        if (video.textTracks[0]) video.textTracks[0].mode = captions ? 'showing' : 'disabled';
        if (playing) video.play().catch(() => {});
        else video.pause();
      };
      video.addEventListener('loadedmetadata', metadataListener, {once:true});
      video.load();
    }
    media.addEventListener('change', event => select(event.matches ? 'mobile' : 'desktop'));
    video.addEventListener('pause', () => video.autoplay = false);
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) select(desired);
    });
    video.addEventListener('webkitbeginfullscreen', () => fullscreen = true);
    video.addEventListener('webkitendfullscreen', () => { fullscreen = false; select(desired); });
    select(desired);
  })();
</script>

<style>
  .grade-film :global(video.demo-video[data-variant="mobile"]::cue) { font-size: 16px; }
  @media (max-width: 360px) {
    .grade-film :global(video.demo-video[data-variant="mobile"]::cue) { font-size: 14px; }
  }
  @media (max-width: 760px) {
    .grade-film :global(video.demo-video) { aspect-ratio: 4 / 5; }

  }
</style>
