---
/**
 * "Features" on /grade: one text card per feature (kicker, name, caption).
 * Every caption describes what the app does today.
 */
const features = [
  {
    kicker: "Grading",
    title: "Step-by-step",
    caption:
      "Check answers quickly, or see a worked solution. Where working is shown, review a possible explanation for an error.",
  },
  {
    kicker: "Multi-page",
    title: "Whole assignments",
    caption:
      "Scan several pages and grade them together—even when a question continues on the next page.",
  },
  {
    kicker: "Comprehension",
    title: "Reading help",
    caption:
      "Add the passage and the questions. The app uses the passage to check answers without marking the passage itself.",
  },
  {
    kicker: "Phone & tablet",
    title: "Scan & grade",
    caption:
      "Take a photo of the homework. See marks on the page, all in one app.",
  },
  {
    kicker: "Subjects",
    title: "Many subjects",
    caption:
      "Check handwritten math, science, reading, and essays—from everyday homework to advanced problems.",
  },
  {
    kicker: "Writing",
    title: "Essay feedback",
    caption:
      "Get feedback on grammar and writing, paragraph by paragraph. Use the standard rubric or add your own criteria.",
  },
];
---
<section id="features" class="section-pad band-cream2">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="eyebrow">Features</span>
      <h2>Your AI grading assistant</h2>
      <p>Scan homework. Understand mistakes. Help learning move forward.</p>
    </div>

    <ul class="gf-grid reveal">
      {features.map((f) => (
        <li class="gf-card">
          <span class="gf-kicker">{f.kicker}</span>
          <h3 class="gf-title">{f.title}</h3>
          <p class="gf-caption">{f.caption}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .gf-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 0; padding: 0; list-style: none; }

  .gf-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 26px;
    border-radius: var(--radius);
    color: var(--color-cream);
    background:
      radial-gradient(120% 70% at 100% 0%, rgb(232 166 46 / 0.2), transparent 60%),
      var(--color-forest);
  }

  .gf-kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #e8a62e;
  }

  .gf-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-cream);
    text-wrap: balance;
  }

  .gf-caption { margin: 0; font-size: 1.02rem; line-height: 1.6; color: rgb(250 248 241 / 0.86); }

  @media (max-width: 900px) {
    .gf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  }
  @media (max-width: 600px) {
    .gf-grid { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .gf-card { padding: 22px 20px; }
    .gf-title { font-size: 1.25rem; }
    .gf-caption { font-size: 0.98rem; line-height: 1.55; }
  }
</style>
