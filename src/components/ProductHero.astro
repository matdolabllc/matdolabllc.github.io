---
interface Props {
  name: string;
  mark: string;
  subtitle: string;
  description: string;
  accent?: string;
}
const { name, mark, subtitle, description, accent = "var(--color-teal)" } = Astro.props;
---
<section class="product-hero" style={`--product-accent:${accent}`}>
  <div class="wrap product-top">
    <div class="product-copy">
      <img class="product-mark" src={mark} width="552" height="782" alt="" />
      <h1>{name}</h1>
      <p class="product-sub">{subtitle}</p>
      <p class="product-lede">{description}</p>
    </div>
    <div class="product-actions"><slot name="downloads" /></div>
  </div>
  <div class="wrap"><slot name="video" /></div>
</section>
<style>
  .product-hero { padding: 140px 0 60px; }
  .product-top { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 48px; align-items: start; }
  .product-copy { min-width: 0; min-height: 360px; }
  .product-mark { display: block; height: 96px; width: auto; margin-bottom: 1.1rem; }
  h1 { font-size: clamp(2.5rem, 8vw, 5.5rem); line-height: 1; letter-spacing: -0.03em; }
  .product-sub { font-family: var(--font-display); font-size: clamp(1.25rem, 3vw, 1.9rem); color: var(--product-accent); font-weight: 500; line-height: 1.25; margin: 0.6rem 0 0; }
  .product-lede { font-size: 1.15rem; color: #3d4b47; max-width: 38rem; margin: 1.1rem 0 0; }
  .product-actions { padding-top: 113px; }
  .product-actions :global(.store-badges) { flex-direction: column; align-items: stretch; gap: 14px; }
  .product-actions :global(.store-badge), .product-actions :global(.asb) { width: 100%; min-width: 0; padding: 11px 20px; gap: 12px; }
  .product-actions :global(.asb-logo) { width: 24px; height: 27px; }
  .product-hero :global(.video-frame) { margin: 2.6rem auto 0; max-width: 1000px; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); border: 1px solid var(--color-line); background: var(--color-cream); }
  .product-hero :global(.demo-video) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  @media (max-width: 900px) {
    .product-hero { padding: 116px 0 44px; }
    .product-top { grid-template-columns: minmax(0, 1fr); gap: 26px; }
    .product-copy { min-height: 360px; }
    .product-mark { height: 74px; margin-bottom: 0.9rem; }
    .product-actions { padding-top: 0; min-height: 130px; }
    .product-actions :global(.store-badges) { align-items: flex-start; }
    .product-actions :global(.store-badge), .product-actions :global(.asb) { width: 220px; }
  }
</style>
