---
// Grade download badge: inactive until an App Store URL is supplied.
interface Props { href?: string; class?: string; }
const { href, class: cls = "" } = Astro.props;
const Tag = href ? "a" : "span";
---
<Tag
  class={`asb ${href ? "" : "soon"} ${cls}`}
  href={href}
  rel={href ? "noopener" : undefined}
  aria-label={href ? "Download Matdo Grade on the App Store" : "Matdo Grade on the App Store — not yet available"}
  aria-disabled={href ? undefined : "true"}
  role={href ? undefined : "img"}
>
  <svg class="asb-logo" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true">
    <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
  </svg>
  <span class="asb-text"><small>Download on the</small><strong>App Store</strong></span>
</Tag>

<style>
  .asb {
    position: relative; display: inline-flex; align-items: center; gap: 12px;
    padding: 10px 20px 10px 16px; min-width: 180px;
    border-radius: 12px; border: 1px solid rgb(255 255 255 / 0.14);
    background: #1a2422; color: #fff; white-space: nowrap;
  }
  a.asb { transition: transform 0.2s, box-shadow 0.2s; }
  a.asb:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .asb.soon { cursor: default; opacity: 0.55; }

  .asb-logo { width: 24px; height: 27px; flex: none; }
  .asb-text { display: flex; flex-direction: column; line-height: 1.12; text-align: left; }
  .asb-text small { font-size: 0.66rem; font-weight: 500; letter-spacing: 0.02em; opacity: 0.9; }
  .asb-text strong { font-family: var(--font-display); font-size: 1.16rem; font-weight: 600; }
</style>
