---
// "Matdo Check at a Glance": a day at the center, one step at a time. Each step
// shows a real 1.3 capture (2026-10-18; iPad Pro 11-inch, a 13-inch iPad upright
// for Edit Time) with numbered pins on the features that step is about, and
// the same numbers in the list beside it.
//
// Pin positions are percentages of the capture itself. The screen boxes below
// are sized to each capture's exact aspect ratio, so nothing is cropped and a
// pin stays on its button at every width. A pin sits on the top-left corner
// (or the left edge) of what it points at, so it never hides the label. Retaking a screenshot means checking
// its pins again.
//
// Sources: matdo-check app-store-1.3.0-assets/screenshots-iPad/plain/01–04,
// matdo-check build/ipad13-plain/04-edit-time (the 13-inch iPad simulator), and
// Marketing/assets/1.3/iphone-records (the iPhone half of the App Store header).
// Words follow the 1.3.0 App Store description (docs/AppStore-1.3.0.md).

// On the sync step, `on` says which screen a pin sits on; a point without one
// is listed but not pinned.
type Pin = { x: number; y: number; t: string; d: string; on?: "ipad" | "iphone" };
type Step = {
  id: string;
  label: string;
  title: string;
  lead: string;
  device: "ipad" | "ipad-tall" | "iphone" | "both";
  img?: string;
  alt: string;
  pins: Pin[];
  // How-to clips from the Tutorial Videos section below (public/demo/tutorials/),
  // opened in its lightbox and listed under the screen. Titles match that
  // section's cards; `s` is the clip's length in seconds (ffprobe of the .mp4),
  // so re-check it when a clip is re-cut.
  videos?: { v: string; t: string; s: number }[];
};

const steps: Step[] = [
  {
    id: "check-in",
    label: "Check in",
    title: "Students check themselves in.",
    lead: "The device on your counter becomes the kiosk. No accounts, no passwords, and it keeps working when the Wi-Fi doesn't.",
    device: "ipad",
    img: "kiosk",
    alt: "The Matdo Check kiosk: Who's here today?, a name search field, Check In and Check Out buttons, and Reset, Add Attendee and Management below",
    videos: [
      { v: "first-run", t: "Set up a new iPad", s: 109 },
      { v: "check-in", t: "Check in", s: 57 },
      { v: "check-out", t: "Check out", s: 50 },
      { v: "reset", t: "Reset check-in", s: 76 },
      { v: "set-pin", t: "Change the PIN", s: 67 },
      { v: "forgot-pin", t: "Forgot the PIN", s: 64 },
    ],
    pins: [
      { x: 23.3, y: 43.6, t: "Type a name", d: "First or last name. The match appears as they type." },
      { x: 23.6, y: 58.2, t: "Tap Check In", d: "Check In on arrival, Check Out to leave, with a full-screen welcome." },
      { x: 42.8, y: 6.4, t: "A live clock", d: "Always in your center's own timezone." },
      { x: 59.9, y: 72.6, t: "Management", d: "The instructor panel, behind a six-digit PIN." },
    ],
  },
  {
    id: "records",
    label: "Watch the day",
    title: "See who's in class, and for how long.",
    lead: "Records is the live dashboard behind the PIN. Every arrival and departure lands here the moment it happens.",
    device: "ipad",
    img: "records",
    alt: "The Attendance Dashboard: counts for In Class, Already Done, Not Present and Unenrolled, a Check Out All Now bar, and attendee rows with times and buttons",
    videos: [
      { v: "time-in-class", t: "Time in class", s: 85 },
      { v: "check-out-from-records", t: "Check in or out from Records", s: 100 },
      { v: "check-out-all", t: "Close up for the day", s: 105 },
      { v: "another-day", t: "Look at another day", s: 97 },
    ],
    pins: [
      { x: 25.3, y: 28.6, t: "The day in four numbers", d: "In class now, already done, not present, unenrolled." },
      { x: 44.3, y: 58.4, t: "Time in class", d: "Highlighted when someone has stayed too long." },
      { x: 63, y: 58.4, t: "One-tap check-in and out", d: "For the student who forgot to stop at the kiosk." },
      { x: 3, y: 38.2, t: "Close up for the day", d: "Hold for two seconds to check everyone still here out." },
      { x: 95, y: 23.2, t: "Any day, not just today", d: "Step back through earlier dates." },
    ],
  },
  {
    id: "edit-time",
    label: "Fix a time",
    title: "Correct a time in one tap.",
    lead: "Someone forgot to check out? Tap Edit Time on their row. The check-in and the check-out each get their own card.",
    device: "ipad-tall",
    img: "edit-time",
    alt: "Edit Time on an iPad for Daniel Cho: a Check In card at 5:20 PM and a Check Out card at 6:27 PM, each with Reset, the time in class, and an Override button",
    videos: [
      { v: "fix-time", t: "Fix a time", s: 98 },
      { v: "change-log", t: "The change log", s: 86 },
    ],
    pins: [
      { x: 43.6, y: 58.2, t: "Change a time", d: "Tap the check-in or check-out time and pick the right one." },
      { x: 66.4, y: 64.2, t: "Reset", d: "Clear a time that shouldn't be there." },
      { x: 23.5, y: 70.9, t: "Override", d: "Saves in one tap, with the old and new times written to a read-only change log." },
    ],
  },
  {
    id: "add-names",
    label: "Add names",
    title: "Bring your roster in.",
    lead: "Type names, paste them from the spreadsheet you already keep, or import the file. Enroll and unenroll without losing anyone's history.",
    device: "ipad",
    img: "add-new",
    alt: "The Add New Attendee table with Paste Columns, Add Row and Clear buttons, Last Name, First Name and Phone columns, and Or Upload a Name Sheet below",
    videos: [
      { v: "add-name", t: "Add attendees", s: 105 },
      { v: "paste-columns", t: "Paste from a spreadsheet", s: 119 },
      { v: "upload", t: "Import CSV", s: 114 },
      { v: "edit-profile", t: "Edit profile", s: 92 },
      { v: "enroll-unenroll", t: "Enroll & unenroll", s: 97 },
    ],
    pins: [
      { x: 15.6, y: 26.3, t: "Paste Columns", d: "Straight from Excel, Numbers or Google Sheets. A header row is skipped." },
      { x: 15.6, y: 32.4, t: "Or type them in", d: "Last name, first name, and a phone if you want one." },
      { x: 12.4, y: 86.8, t: "Or upload a name sheet", d: "A .csv or .xlsx file." },
    ],
  },
  {
    id: "export",
    label: "Keep the record",
    title: "Backed up every day, in your own iCloud.",
