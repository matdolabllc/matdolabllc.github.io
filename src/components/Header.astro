---
import Logo from "./Logo.astro";
import { APP_STORE_URL } from "../consts";

const nav = [
  { label: "Home", href: "/" },
  { label: "Matdo Check", href: "/check/" },
  { label: "Matdo Grade", href: "/grade/", soon: false },
  { label: "About", href: "/about/" },
];

// Highlight the active top-level route. Links end in "/" because GitHub Pages
// redirects /check to /check/, so the path is compared in that form too.
const path = Astro.url.pathname.replace(/\/?$/, "/");

// Support follows the product being viewed, as in the footer.
const isGrade = /^\/grade\//.test(path) || /^\/(privacy|terms|support)\/grade\/$/.test(path);
nav.push({ label: "Support", href: `/support/${isGrade ? "grade" : "check"}/` });
nav.push({ label: "Contact", href: "/contact/" });
---
<header id="site-header">
  <div class="wrap nav">
    <Logo />

    <nav class="nav-links" aria-label="Primary">
      {nav.map((i) => (
        i.soon ? (
          <span class="link soon" aria-disabled="true">{i.label}<span class="soon-tag">Soon</span></span>
        ) : (
          <a class="link" href={i.href} aria-current={path === i.href || (i.label === "Support" && path.startsWith("/support")) ? "page" : undefined}>{i.label}</a>
        )
      ))}
    </nav>

    <div class="nav-right">
      <!-- The header's buttons are the two things a visitor can do next. Contact is a nav link. -->
      <a class="btn hb hb-check" href={APP_STORE_URL} rel="noopener" aria-label="Try Matdo Check free on the App Store"><span>Try Check<span class="hb-free"> free</span></span></a>
      <a class="btn hb hb-grade" href="/grade/try/">Join Grade</a>
      <button id="menu-toggle" class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="24" height="24">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="mobile-menu" hidden>
    {nav.map((i) => (
      i.soon
        ? <span class="mm-soon" aria-disabled="true">{i.label}<span class="soon-tag">Soon</span></span>
        : <a href={i.href} aria-current={path === i.href || (i.label === "Support" && path.startsWith("/support")) ? "page" : undefined}>{i.label}</a>
    ))}
  </div>
</header>

<style>
  header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    transition: background 0.3s ease, box-shadow 0.3s ease, backdrop-filter 0.3s ease;
    padding: 14px 0;
  }
  header.scrolled {
    background: rgb(250 248 241 / 0.82);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    box-shadow: 0 2px 20px rgb(29 59 52 / 0.07);
    border-bottom: 1px solid var(--color-line);
  }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .nav-links { display: flex; align-items: center; gap: 2rem; }
  .nav-links a.link { font-weight: 500; font-size: 0.96rem; color: var(--color-ink); opacity: 0.85; transition: opacity 0.2s, color 0.2s; }
  .nav-links a.link:hover { opacity: 1; color: var(--color-teal); }
  .nav-links a.link[aria-current="page"] { opacity: 1; color: var(--color-teal); }
  .nav-links .link.soon { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--color-ink); opacity: 0.45; cursor: default; }
  .soon-tag { font-size: 0.58rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #08130d; background: var(--color-mint); padding: 1px 6px; border-radius: 999px; }
  .mm-soon { display: flex; align-items: center; gap: 0.5rem; padding: 0.7rem 0; font-weight: 500; color: var(--color-ink); opacity: 0.5; border-bottom: 1px solid var(--color-line); }
  .nav-right { display: flex; align-items: center; gap: 10px; }
  .hb { min-height: 42px; padding: 9px 16px; font-size: 0.9rem; white-space: nowrap; box-shadow: none; }
  .hb-check { background: var(--color-teal); color: #fff; }
  .hb-check:hover { background: var(--color-teal2); transform: translateY(-1px); }
  .hb-grade { background: #1a2422; color: #fff; }
  .hb-grade:hover { background: var(--color-forest); transform: translateY(-1px); }
  .menu-toggle { display: none; background: none; border: none; color: var(--color-forest); cursor: pointer; padding: 4px; }

  .mobile-menu {
    display: none; flex-direction: column; gap: 0.25rem;
    padding: 0.5rem 24px 1.2rem;
    background: rgb(250 248 241 / 0.96);
    backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--color-line);
  }
  .mobile-menu a { padding: 0.7rem 0; font-weight: 500; color: var(--color-ink); border-bottom: 1px solid var(--color-line); }
  .mobile-menu a:last-child { border-bottom: none; }
  .mobile-menu a[aria-current="page"] { color: var(--color-teal); font-weight: 600; }
  .mobile-menu .mm-contact { color: var(--color-teal); font-weight: 600; }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .menu-toggle { display: inline-flex; }
    .mobile-menu.open { display: flex; }
  }
  @media (max-width: 760px) {
    header { background: rgb(250 248 241 / 0.96); }
    .nav { gap: 12px; }
    .nav-right { gap: 8px; }
    .nav-right .btn { min-height: 44px; padding: 10px 12px; font-size: 0.86rem; }
    .menu-toggle { width: 44px; height: 44px; align-items: center; justify-content: center; }
  }
  @media (max-width: 420px) {
    .nav { gap: 6px; }
    .nav-right { gap: 6px; }
    .nav-right .btn { padding: 10px 9px; font-size: 0.8rem; }
    .menu-toggle { width: 40px; }
    .hb-free { display: none; }
  }
  @media (max-width: 350px) {
    .hb-grade { display: none; }
    .mobile-menu { padding-inline: 20px; max-height: calc(100dvh - 80px); overflow-y: auto; }
    .mobile-menu a { min-height: 44px; }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  const onScroll = () => {
    if (!header) return;
    header.classList.toggle("scrolled", window.scrollY > 20);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setMenu = (open: boolean) => {
    if (!menu || !toggle) return;
    menu.classList.toggle("open", open);
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };
  const isOpen = () => toggle?.getAttribute("aria-expanded") === "true";

  toggle?.addEventListener("click", () => setMenu(!isOpen()));
  // Close after choosing a link, so an in-page link like #pricing isn't hidden behind the menu.
  menu?.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) setMenu(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) { setMenu(false); toggle?.focus(); }
  });
  document.addEventListener("click", (e) => {
    if (isOpen() && header && !header.contains(e.target as Node)) setMenu(false);
  });
</script>
