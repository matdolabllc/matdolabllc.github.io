---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SOCIAL_LINKS } from "../consts";

interface Props {
  title?: string;
  description?: string;
  /** Link-preview card (1200x630). Defaults to the card for the page's product. */
  image?: string;
  /** Keep the page out of search results (invite-only pages). */
  noindex?: boolean;
  /** Extra schema.org objects for this page, e.g. the product's SoftwareApplication. */
  schema?: Record<string, unknown>[];
}
// Without an og:image, iMessage and others pick an arbitrary large image from
// the page. Cards live in public/og and are rendered by design/share-cards.
const path = Astro.url.pathname;
const defaultImage = /\bgrade\b/.test(path) ? "/og/grade.jpg" : /\bcheck\b/.test(path) ? "/og/check.jpg" : "/og/site.jpg";
const {
  title = "Matdo — Less admin, more teaching",
  description = "Matdo makes simple, reliable apps for the people who teach — tutoring and enrichment centers, Sunday schools, clubs, and camps. Matdo Check for attendance; Matdo Grade for AI homework grading.",
  image = defaultImage,
  noindex = false,
  schema = [],
} = Astro.props;
const pageUrl = new URL(path, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

// Structured data so search engines know who runs the site. Every page carries
// the organization and website; product pages add their app via `schema`.
const siteUrl = new URL("/", Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "Matdo Lab LLC",
      alternateName: "Matdo",
      url: siteUrl,
      logo: new URL("/logos/matdo-mark.png", Astro.site).href,
      email: "matdo@matdolab.com",
      sameAs: SOCIAL_LINKS.map((s) => s.url),
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: "Matdo",
      url: siteUrl,
      publisher: { "@id": `${siteUrl}#organization` },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Matdo" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#faf8f1" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Lightweight reveal-on-scroll (no framework, respects reduced motion)
      const els = document.querySelectorAll(".reveal");
      if (
        "IntersectionObserver" in window &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("in"));
      }
    </script>
  </body>
</html>
