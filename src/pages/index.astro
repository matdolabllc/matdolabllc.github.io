---
import Layout from "../layouts/Layout.astro";
import MatdoMark from "../components/MatdoMark.astro";

const features = [
  { t: "Simple", d: "Anyone can use it on day one. No training, no manual.", icon: "smile" },
  { t: "Fast", d: "Check in or grade a stack in seconds, not minutes.", icon: "bolt" },
  { t: "Reliable", d: "It just works, every day — even without internet.", icon: "shield" },
  { t: "Private", d: "Your data stays on your device. No cloud, no tracking.", icon: "lock" },
  { t: "Affordable", d: "Fair, upfront pricing you can plan around.", icon: "tag" },
];

const ICONS: Record<string, string> = {
  smile: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 14.5s1.6 2 4 2 4-2 4-2"/><path d="M9 9.5h.01M15 9.5h.01"/></svg>',
  bolt: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg>',
  shield: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>',
  lock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>',
  tag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 12 22l-9-9V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><path d="M7.5 7.5h.01"/></svg>',
};
const icon = (k: string) => ICONS[k] || "";
---
<Layout
  title="Matdo — Less admin, more teaching"
  description="Matdo makes simple, reliable apps for the people who teach — tutoring and enrichment centers, Sunday schools, clubs, and camps. Matdo Check for attendance; Matdo Grade for AI homework grading (coming soon)."
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <h1 class="hero-title"><span class="hero-logo"><MatdoMark height="1em" /></span>Less Admin. More Teaching.</h1>
      <p class="hero-sub">Simple, reliable, affordable tools for educators.</p>
    </div>
  </section>

  <!-- SECTION 1 — the two apps -->
  <section class="section-pad apps-sec">
    <div class="wrap">
      <div class="apps">
        <!-- Matdo Check (available) — logo on the front, a peek at the app on the back -->
        <a class="flip-card reveal" href="/check" aria-label="Matdo Check — check-in and attendance">
          <div class="flip-inner">
            <div class="flip-face flip-front">
              <img class="flip-logo" src="/logos/matdo-check.png" width="1254" height="1254" alt="" />
              <p class="flip-tag">Check-in &amp; attendance</p>
            </div>
            <div class="flip-face flip-back">
              <div class="flip-shot">
                <img src="/demo/screens/screen-home.webp" width="1600" height="1000" alt="" />
              </div>
              <div class="app-meta">
                <div class="app-id">
                  <img class="app-icon" src="/logos/matdo-check-mark.png" width="552" height="782" alt="" />
                  <div>
                    <h3>Matdo Check</h3>
                    <p>Check-in &amp; attendance</p>
                  </div>
                </div>
                <span class="app-link">Explore →</span>
              </div>
            </div>
          </div>
        </a>

        <!-- Matdo Grade (coming soon) — flips like its sibling, but nothing to open yet -->
        <div class="flip-card reveal is-soon">
          <div class="flip-inner">
            <div class="flip-face flip-front">
              <img class="flip-logo" src="/logos/matdo-grade.png" width="1254" height="1254" loading="lazy" alt="Matdo Grade" />
              <p class="flip-tag">AI homework grading</p>
              <span class="soon-ribbon">Coming soon</span>
            </div>
            <div class="flip-face flip-back">
              <div class="flip-shot">
                <img src="/demo/screens/screen-grade.webp" width="1600" height="1000" loading="lazy" alt="Matdo Grade — AI homework grading" />
                <span class="soon-ribbon">Coming soon</span>
              </div>
              <div class="app-meta">
                <div class="app-id">
                  <img class="app-icon" src="/logos/matdo-grade-mark.png" width="552" height="782" loading="lazy" alt="" />
                  <div>
                    <h3>Matdo Grade</h3>
                    <p>AI homework grading</p>
                  </div>
                </div>
                <span class="app-link disabled" aria-disabled="true">Coming soon</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2 — why Matdo -->
  <section class="section-pad band-cream2">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Why Matdo?</span>
        <h2>Powerful where it counts. Simple everywhere else.</h2>
      </div>
      <div class="why">
        {features.map((f) => (
          <div class="why-item reveal">
            <span class="why-ic" set:html={icon(f.icon)} />
            <h4>{f.t}</h4>
            <p>{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4 — CTA -->
  <section class="section-pad">
    <div class="wrap">
      <div class="cta reveal">
        <h2>Bring Matdo to your workplace.</h2>
        <a class="btn btn-cta" href="/contact">Contact us →</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Touch devices never get a hover, so the front of each card would be all
  // anyone ever sees. Flip them once as they scroll into view instead — a tap
  // still just follows the link.
  if (window.matchMedia("(hover: none)").matches && "IntersectionObserver" in window) {
    const cards = document.querySelectorAll<HTMLElement>(".flip-card");
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          io.unobserve(el);
          window.setTimeout(() => el.classList.add("is-flipped"), 550);
        }
      },
      { threshold: 0.45 },
    );
    cards.forEach((c) => io.observe(c));
  }
</script>

<style>
  /* Hero */
  .hero { padding: 160px 0 40px; text-align: center; }
  .hero-title { font-size: clamp(2.2rem, 6vw, 4.4rem); line-height: 1.15; letter-spacing: -0.03em; }
  /* The mark rides on the first line of the title; -0.12em drops it from the
     text baseline onto the visual baseline of the pocket. */
  .hero-logo { display: inline-block; vertical-align: -0.12em; margin-right: 0.3em; }
  .hero-sub { font-size: 1.2rem; color: #3d4b47; max-width: 40rem; margin: 1.2rem auto 0; }

  /* Section 1 — apps: two flip cards, product logo out front */
  .apps-sec { padding-top: 3rem; }
  .apps { display: grid; grid-template-columns: 1fr 1fr; gap: 34px; }

  .flip-card { display: block; perspective: 1600px; }
  .flip-inner {
    position: relative;
    aspect-ratio: 5 / 4;
    transform-style: preserve-3d;
    transition: transform 0.75s cubic-bezier(0.2, 0.72, 0.24, 1);
  }
  .flip-card:hover .flip-inner,
  .flip-card:focus-visible .flip-inner,
  .flip-card.is-flipped .flip-inner { transform: rotateY(180deg); }

  .flip-face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .flip-card:hover .flip-face,
  .flip-card:focus-visible .flip-face,
  .flip-card.is-flipped .flip-face { box-shadow: var(--shadow-lg); }

  /* Front — the product logo, centred. No padding on the face itself, so the
     ribbon can anchor to the card's own corner. */
  .flip-front { align-items: center; justify-content: center; text-align: center; background: radial-gradient(120% 90% at 50% 8%, #fff 0%, var(--color-cream) 100%); }
  .flip-logo { display: block; width: min(66%, 300px); height: auto; }
  .flip-tag { color: #4a5854; font-size: 1rem; padding: 0 8%; }
  .is-soon .flip-logo { opacity: 0.78; }

  /* Back — a look at the app itself */
  .flip-back { transform: rotateY(180deg); }
  .flip-shot { position: relative; flex: 1; min-height: 0; background: var(--color-cream2); border-bottom: 1px solid var(--color-line); }
  .flip-shot img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }
  .is-soon .flip-shot img { filter: saturate(0.92); }

  .soon-ribbon { position: absolute; top: 16px; right: 16px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #08130d; background: var(--color-gold); padding: 6px 12px; border-radius: 999px; box-shadow: var(--shadow-sm); }
  .app-meta { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 18px 24px; }
  .app-id { display: flex; align-items: center; gap: 14px; }
  .app-icon { flex: none; height: 46px; width: auto; }
  .is-soon .app-icon { opacity: 0.65; }
  .app-meta h3 { font-size: 1.4rem; }
  .app-meta p { color: #4a5854; font-size: 0.95rem; margin-top: 2px; }
  .app-link { font-weight: 600; color: var(--color-teal); white-space: nowrap; }
  .flip-card:hover .app-link:not(.disabled) { text-decoration: underline; text-underline-offset: 3px; }
  .app-link.disabled { color: #9aa39d; }

  /* No hover to flip with: a card flips once as it scrolls into view (see the
     script above), and a tap still goes straight to the product page. */
  @media (hover: none) {
    .flip-inner { transition-duration: 0.9s; }
  }

  /* Reduced motion: cross-fade the faces instead of spinning the card. */
  @media (prefers-reduced-motion: reduce) {
    .flip-inner { transition: none; transform: none !important; }
    .flip-face { backface-visibility: visible; transition: opacity 0.25s linear; }
    .flip-back { transform: none; opacity: 0; }
    .flip-card:hover .flip-front,
    .flip-card:focus-visible .flip-front,
    .flip-card.is-flipped .flip-front { opacity: 0; }
    .flip-card:hover .flip-back,
    .flip-card:focus-visible .flip-back,
    .flip-card.is-flipped .flip-back { opacity: 1; }
  }

  /* Section 2 — why */
  .why { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; }
  .why-item { background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius); padding: 30px 26px; text-align: center; box-shadow: var(--shadow-sm); }
  .why-ic { display: inline-grid; place-items: center; width: 56px; height: 56px; border-radius: 16px; background: rgb(79 209 197 / 0.16); color: var(--color-teal); margin-bottom: 1rem; }
  .why-ic :global(svg) { width: 28px; height: 28px; }
  .why-item h4 { font-size: 1.2rem; margin-bottom: 0.4rem; }
  .why-item p { color: #4a5854; font-size: 0.94rem; line-height: 1.5; }

  /* Section 4 — CTA */
  .cta { background: linear-gradient(140deg, var(--color-forest), var(--color-teal)); border-radius: 32px; padding: clamp(40px, 7vw, 72px); text-align: center; color: #fff; box-shadow: var(--shadow-lg); position: relative; overflow: hidden; }
  .cta::before { content: ""; position: absolute; width: 320px; height: 320px; border-radius: 50%; background: radial-gradient(circle, rgb(79 209 197 / 0.35), transparent 70%); top: -120px; right: -60px; }
  .cta h2 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); position: relative; z-index: 1; margin-bottom: 1.8rem; }
  .cta p { color: rgb(255 255 255 / 0.85); max-width: 34rem; margin: 1rem auto 2rem; position: relative; z-index: 1; font-size: 1.1rem; }
  .btn-cta { background: #fff; color: var(--color-forest); position: relative; z-index: 1; box-shadow: 0 10px 30px rgb(0 0 0 / 0.2); }
  .btn-cta:hover { transform: translateY(-2px); box-shadow: 0 16px 40px rgb(0 0 0 / 0.25); background: var(--color-gold); }

  @media (max-width: 900px) {
    .hero { padding: 128px 0 24px; }
    .apps { grid-template-columns: 1fr; gap: 26px; }
    .why { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .why { grid-template-columns: 1fr; }
    /* A phone-width card is short, and the two faces share its height — so
       trim the meta strip to one line and leave the screenshot some room. */
    .flip-inner { aspect-ratio: 4 / 3; }
    .flip-logo { width: min(54%, 190px); }
    .flip-tag { font-size: 0.92rem; }
    .app-meta { padding: 12px 18px; }
    .app-icon { height: 34px; }
    .app-meta h3 { font-size: 1.15rem; }
    .app-meta p { display: none; }
    .app-link { font-size: 0.92rem; }
  }
</style>
