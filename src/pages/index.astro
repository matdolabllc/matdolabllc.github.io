---
import Layout from "../layouts/Layout.astro";
import MatdoMark from "../components/MatdoMark.astro";

---
<Layout
  title="Matdo — Less admin, more teaching"
  description="Matdo makes simple, reliable apps for the people who teach — tutoring and enrichment centers, Sunday schools, clubs, and camps. Matdo Check for attendance; Matdo Grade for AI homework grading."
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <h1 class="hero-title"><span class="hero-logo"><MatdoMark height="1em" /></span>Less Admin. More Teaching.</h1>
      <p class="hero-sub">Simple, reliable, affordable tools for educators.</p>
    </div>
  </section>

  <!-- Product previews: visible on every device, without a hover or tap. -->
  <section class="section-pad apps-sec" aria-label="Matdo products">
    <div class="wrap">
      <div class="apps">
        <a class="product-card product-check reveal" href="/check">
          <div class="product-heading">
            <img class="app-icon" src="/logos/matdo-check-mark.png" width="552" height="782" alt="" />
            <div><h2>Matdo Check</h2><p>Check-in &amp; attendance</p></div>
          </div>
          <div class="product-preview check-preview">
            <img src="/demo/screens/screen-checkin.webp" width="1600" height="1000" alt="Matdo Check attendance screen with check-in and check-out actions" />
          </div>
          <div class="product-caption"><p>Run your front desk from an iPad.</p><span>Explore Check <span aria-hidden="true">→</span></span></div>
        </a>
        <a class="product-card product-grade reveal" href="/grade">
          <div class="product-heading">
            <img class="app-icon" src="/logos/matdo-grade-mark.png" width="552" height="782" alt="" />
            <div><h2>Matdo Grade</h2><p>AI homework grading</p></div>
          </div>
          <div class="product-preview grade-preview">
            <img src="/demo/screens/grade-home.webp" width="600" height="1304" alt="Matdo Grade home screen with capture and grading controls" />
            <img src="/demo/screens/grade-marks.webp" width="600" height="1304" alt="Matdo Grade showing checks and corrections on handwritten homework" />
          </div>
          <div class="product-caption"><p>Scan homework. Review the feedback.</p><span>Explore Grade <span aria-hidden="true">→</span></span></div>
        </a>
      </div>
    </div>
  </section>
  <!-- SECTION 2 — why Matdo -->
  <section class="section-pad why-sec" aria-labelledby="why-title">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Why Matdo?</span>
        <h2 id="why-title">Attendance sorted. Homework understood.</h2>
      </div>
      <div class="why">
        <article class="why-item why-check reveal">
          <div class="why-top">
            <span class="why-label">Matdo Check</span>
            <span class="why-purpose">Attendance</span>
          </div>
          <figure class="why-picture">
            <img src="/demo/cartoons/check-in-illustration.webp" width="960" height="720" loading="lazy" alt="A smiling child checking in on a tablet at a welcoming tutoring center reception desk" />
            <figcaption>Tap in. Tap out. Attendance sorted.</figcaption>
          </figure>
          <ul class="why-benefits">
            <li>Quick check-in and check-out</li>
            <li>Works offline on your iPad</li>
            <li>Attendance records stay on your device</li>
            <li>Automatic backups to your own iCloud</li>
          </ul>
          <a class="why-link" href="/check">Explore Matdo Check <span aria-hidden="true">→</span></a>
        </article>
        <article class="why-item why-grade reveal">
          <div class="why-top">
            <span class="why-label">Matdo Grade</span>
            <span class="why-purpose">Homework</span>
          </div>
          <figure class="why-picture">
            <img src="/demo/grade/features/parent-ipad-illustration.webp" width="960" height="720" loading="lazy" alt="A mother holding an iPad helping her child with homework, with a corner inset showing marked math answers on an iPad" />
            <figcaption>Scan. Check. Help them learn.</figcaption>
          </figure>
          <ul class="why-benefits">
            <li>Scan handwritten homework</li>
            <li>Check math, science, reading and essays</li>
            <li>See worked solutions and writing feedback</li>
            <li>Review AI results and make the final call</li>
          </ul>
          <a class="why-link" href="/grade">Explore Matdo Grade <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <!-- SECTION 4 — CTA -->
  <section class="section-pad">
    <div class="wrap">
      <div class="cta reveal">
        <h2>Get Matdo products today.</h2>
        <div class="cta-actions">
          <a class="btn btn-cta cta-check" href="/check">Explore Matdo Check →</a>
          <a class="btn btn-cta cta-grade" href="/grade">Explore Matdo Grade →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>



<style>
  /* Hero */
  .hero { padding: 136px 0 24px; text-align: center; }
  .hero-title { font-size: clamp(2.2rem, 6vw, 4.4rem); line-height: 1.15; letter-spacing: -0.03em; }
  /* The mark rides on the first line of the title; -0.12em drops it from the
     text baseline onto the visual baseline of the pocket. */
  .hero-logo { display: inline-block; vertical-align: -0.12em; margin-right: 0.3em; }
  .hero-sub { font-size: 1.2rem; color: #3d4b47; max-width: 40rem; margin: 1.2rem auto 0; }

  /* Shared product accents and card treatment. */
  .apps-sec { padding-top: 2rem; }
  .apps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .product-card, .why-item { --product-accent: var(--color-teal); --product-tint: #edf3ee; border-radius: 16px; box-shadow: 0 2px 8px rgb(29 59 52 / 0.04); }
  .product-grade, .why-grade { --product-accent: #806123; --product-tint: #f3eede; }
  .product-card { display: flex; flex-direction: column; overflow: hidden; background: var(--color-cream); border: 1px solid var(--color-line); border-top: 4px solid var(--product-accent); color: var(--color-forest); }
  .product-card:hover { border-color: var(--product-accent); }
  .product-card:focus-visible { outline: 3px solid var(--product-accent); outline-offset: 4px; }
  .product-heading { display: flex; align-items: center; gap: 16px; padding: 24px; }
  .app-icon { height: 48px; width: auto; flex: none; }
  .product-heading h2 { font-size: 1.6rem; }
  .product-heading p { font-size: 0.94rem; color: #55665f; margin-top: 4px; }
  .product-preview { height: clamp(260px, 30vw, 350px); padding: 20px; background: var(--product-tint); display: flex; align-items: center; justify-content: center; gap: 20px; }
  .product-preview img { display: block; max-width: 100%; max-height: 100%; object-fit: contain; border: 1px solid var(--color-line); border-radius: 10px; }
  .grade-preview img { width: auto; max-width: 44%; height: 100%; }
  .product-caption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 22px 24px; }
  .product-caption p { font-size: 0.92rem; color: #55665f; }
  .product-caption > span { font-size: 0.92rem; font-weight: 700; color: var(--product-accent); }
  /* Section 2 — why */
  .why-sec { background: var(--color-cream2); }
  .why-sec .eyebrow { color: var(--color-forest); }
  .why-sec h2 { margin-inline: auto; white-space: nowrap; font-size: clamp(0.95rem, 3.6vw, 2.65rem); letter-spacing: -0.025em; }
  .why { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .why-item {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid var(--color-line);
    border-top: 4px solid var(--product-accent);
    background: var(--color-cream);
    color: var(--color-forest);
  }

  .why-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; }
  .why-label { color: var(--product-accent); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .why-purpose { color: #55665f; font-size: 0.8rem; }
  .why-picture { margin: 0 0 28px; text-align: center; }
  .why-picture img { display: block; width: 100%; aspect-ratio: 4 / 3; height: auto; object-fit: contain; margin: 0 auto 20px; border-radius: 10px; }
  .why-picture figcaption { font-family: var(--font-display); color: var(--color-forest); font-weight: 600; font-size: clamp(1.3rem, 2vw, 1.6rem); line-height: 1.3; min-height: 2.6em; display: grid; place-items: center; text-wrap: balance; }
  .why-benefits { margin: 0 0 28px; padding-left: 1.2rem; }
  .why-benefits li { padding-left: 4px; margin-bottom: 10px; color: #4a5854; font-size: 0.95rem; line-height: 1.5; }
  .why-benefits li::marker { color: var(--product-accent); }
  .why-link { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: auto; padding-top: 8px; color: var(--color-forest); font-weight: 700; }
  .why-link span { color: var(--product-accent); font-size: 1.4rem; }
  .why-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  /* Closing action: one surface, one route for each product. */
  .cta { background: var(--color-forest); border-radius: 16px; padding: clamp(32px, 6vw, 64px); text-align: center; }
  .cta h2 { color: var(--color-cream); font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: 28px; }
  .cta-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 16px; }
  .btn-cta { background: var(--color-cream); color: var(--color-forest); border-radius: 12px; box-shadow: none; border: 2px solid transparent; }
  .cta-check { border-color: #7c9a6f; }
  .cta-grade { background: var(--color-gold); border-color: #b08a3e; }
  .btn-cta:hover { background: #fff; box-shadow: none; transform: none; }
  @media (max-width: 760px) {
    .hero { padding: 116px 0 20px; }
    .apps, .why { grid-template-columns: 1fr; }
    .product-preview { height: 300px; }
  }
  @media (max-width: 520px) {
    .product-heading, .product-caption { padding: 20px; }
    .product-heading h2 { font-size: 1.4rem; }
    .product-preview { height: 260px; padding: 16px; gap: 16px; }
    .why-item { padding: 20px; }
    .cta-actions { flex-direction: column; }
  }
</style>
