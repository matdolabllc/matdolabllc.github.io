---
import Layout from "../layouts/Layout.astro";
import MatdoMark from "../components/MatdoMark.astro";
---
<Layout
  title="About — Matdo"
  description="Meet Matdo: simple, reliable, affordable tools for parents, tutors, and educators. Discover the story behind our name, our logo, and our mission: less admin, more teaching."
>
  <section class="page-hero" aria-labelledby="about-title">
    <div class="wrap">
      <span class="eyebrow">About</span>
      <h1 id="about-title"><span class="hero-logo"><MatdoMark height="1em" /></span>About Matdo</h1>
      <p class="lede">Simple, reliable, affordable tools for parents, tutors, and educators.</p>
    </div>
  </section>

  <section class="about-section band-cream2" aria-labelledby="mission-title">
    <div class="wrap story-copy reveal">
      <span class="eyebrow">Our mission</span>
      <h2 id="mission-title" class="mission-line">Less admin. More teaching.</h2>
      <p>From checking children in to checking their homework, everyday tasks take time. Matdo builds focused tools that make those tasks easier—so parents and educators can spend more time helping children learn.</p>
    </div>
  </section>

  <section class="about-section" aria-labelledby="name-title">
    <div class="wrap name-sec">
      <div class="name-badge reveal">
        <span class="mat-cn" lang="zh-HK">乜都</span>
        <span class="mat-say">“Mut&nbsp;Dou”</span>
        <span class="mat-mean">everything</span>
      </div>
      <div class="name-body reveal">
        <span class="eyebrow">The name</span>
        <h2 id="name-title">Matdo means “everything.”</h2>
        <p>Matdo comes from the Cantonese expression <span lang="zh-HK">乜都</span>—<strong>“Mut&nbsp;Dou”</strong>, meaning <em>everything</em>.</p>
        <p>For us, it means taking care of the everyday tasks around learning, from attendance to homework.</p>
      </div>
    </div>
  </section>

  <section class="about-section band-cream2" aria-labelledby="people-title">
    <div class="wrap">
      <div class="section-heading reveal">
        <span class="eyebrow">Our tools</span>
        <h2 id="people-title">Who we build for</h2>
        <p>At the front desk, at the homework table, and wherever learning happens.</p>
      </div>
      <div class="people-grid">
        <article class="people-card check-card reveal">
          <span class="product-label">Matdo Check</span>
          <img class="people-picture" src="/demo/about/community-check-in.webp" width="1448" height="1086" loading="lazy" decoding="async" alt="Two children with backpacks arriving at a community program, with a girl checking in on an iPad beside a smiling facilitator" />
          <h3>For centers and communities</h3>
          <p>Matdo Check helps centers manage check-in and attendance on iPad. From tutoring centers to clubs and camps, keep the front desk running smoothly.</p>
          <p class="privacy-note">Attendance records stay on your device. <a href="/privacy/check">Check privacy details <span aria-hidden="true">→</span></a></p>
        </article>
        <article class="people-card grade-card reveal">
          <span class="product-label">Matdo Grade</span>
          <img class="people-picture" src="/demo/about/father-daughter-homework.webp" width="1448" height="1086" loading="lazy" decoding="async" alt="A father helping his daughter understand a step in her homework, with an iPad on the table showing checks and a correction" />
          <h3>For parents, tutors, and teachers</h3>
          <p>Matdo Grade helps you scan homework, understand mistakes, and review AI feedback on iPad and iPhone. You review the results and make the final call.</p>
          <p class="privacy-note">Learn how homework is processed for AI grading. <a href="/privacy/grade">Grade privacy details <span aria-hidden="true">→</span></a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="about-section" aria-labelledby="logo-title">
    <div class="wrap story-copy reveal">
      <span class="eyebrow">The logo</span>
      <h2 id="logo-title">A pocket for useful tools</h2>
      <p>Our mark combines an <strong>M</strong> with a <strong>D-shaped pocket</strong>. If the pocket reminds you of a certain <strong>blue robot cat</strong>, that’s the idea: a little assistant with a useful tool close at hand, ready to help when you need it. Check adds a checkmark; Grade adds a gold A+. Each belongs to the same Matdo family, with a different tool in its pocket.</p>
      <div class="logo-row">
        <figure class="logo-card">
          <MatdoMark height="96px" />
          <figcaption>Matdo</figcaption>
        </figure>
        <figure class="logo-card check-card">
          <img src="/logos/matdo-check-mark.png" alt="" width="552" height="782" loading="lazy" />
          <figcaption>Matdo Check</figcaption>
        </figure>
        <figure class="logo-card grade-card">
          <img src="/logos/matdo-grade-mark.png" alt="" width="552" height="782" loading="lazy" />
          <figcaption>Matdo Grade</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="closing-section" aria-labelledby="explore-title">
    <div class="wrap">
      <div class="about-cta reveal">
        <h2 id="explore-title">Find your next useful tool.</h2>
        <div class="cta-actions">
          <a class="btn explore-check" href="/check">Explore Matdo Check <span aria-hidden="true">→</span></a>
          <a class="btn explore-grade" href="/grade">Explore Matdo Grade <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding: 136px 0 60px; text-align: center; }
  .page-hero h1 { font-size: clamp(2.4rem, 6vw, 4.4rem); letter-spacing: -0.03em; margin: 1rem 0 1.1rem; }
  .hero-logo { display: inline-block; vertical-align: -0.12em; margin-right: 0.3em; }
  .lede { font-size: 1.2rem; color: #3d4b47; max-width: 42rem; margin-inline: auto; }
  .about-section { padding: clamp(56px, 7vw, 88px) 0; }
  .story-copy { max-width: 828px; text-align: center; }
  .story-copy h2, .name-body h2, .section-heading h2 { font-size: clamp(1.9rem, 3.6vw, 2.7rem); margin: 0.8rem 0 1rem; text-wrap: balance; }
  .story-copy .mission-line { font-size: clamp(2.2rem, 5vw, 3.4rem); letter-spacing: -0.02em; }
  .story-copy p, .name-body p, .section-heading p { color: #3d4b47; font-size: 1.08rem; line-height: 1.7; }
  strong { color: var(--color-forest); font-weight: 600; }

  .name-sec { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: 56px; align-items: center; max-width: 1000px; }
  .name-badge { background: var(--color-forest); color: var(--color-cream); border-radius: 16px; padding: 44px 28px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .mat-cn { font-size: 4.6rem; line-height: 1.1; font-weight: 700; letter-spacing: 0.04em; }
  .mat-say { font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; color: var(--color-gold); margin-top: 8px; }
  .mat-mean { font-size: 0.85rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(250 248 241 / 0.8); font-weight: 600; }
  .name-body p { margin: 0 0 1rem; }
  .name-body p:last-child { margin-bottom: 0; }

  .section-heading { max-width: 42rem; margin: 0 auto 36px; text-align: center; }
  .people-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .people-card, .logo-card { --product-accent: var(--color-forest); background: var(--color-cream); border: 1px solid var(--color-line); border-radius: 16px; box-shadow: 0 2px 8px rgb(29 59 52 / 0.04); }
  .check-card { --product-accent: var(--color-teal); }
  .grade-card { --product-accent: #806123; }
  .people-card { display: flex; flex-direction: column; padding: clamp(20px, 3vw, 32px); border-top: 4px solid var(--product-accent); }
  .product-label { font-size: 0.82rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--product-accent); }
  .people-picture { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; border-radius: 10px; margin: 20px 0 24px; }
  .people-card h3 { font-size: clamp(1.3rem, 2vw, 1.65rem); line-height: 1.25; text-wrap: balance; }
  .people-card p { color: #4a5854; font-size: 0.98rem; line-height: 1.65; margin: 16px 0 24px; }
  .people-card .privacy-note { margin: auto 0 0; padding-top: 20px; border-top: 1px solid var(--color-line); font-size: 0.86rem; }
  .privacy-note a { display: block; width: fit-content; margin-top: 8px; color: var(--product-accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

  .logo-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 32px; }
  .logo-card { margin: 0; padding: 28px 16px 24px; display: flex; flex-direction: column; align-items: center; gap: 20px; border-top: 4px solid var(--product-accent); }
  .logo-card img { height: 96px; width: auto; }
  .logo-card figcaption { font-family: var(--font-display); font-weight: 600; color: var(--color-forest); font-size: 1.1rem; }

  .closing-section { padding: 0 0 clamp(56px, 7vw, 88px); }
  .about-cta { background: var(--color-forest); border-radius: 16px; padding: clamp(32px, 6vw, 64px); text-align: center; }
  .about-cta h2 { color: var(--color-cream); font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: 28px; text-wrap: balance; }
  .cta-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 16px; }
  .cta-actions .btn { background: var(--color-cream); color: var(--color-forest); border-radius: 12px; box-shadow: none; border: 2px solid var(--color-sage); }
  .cta-actions .explore-grade { background: var(--color-gold); border-color: #b08a3e; }
  .cta-actions .btn:hover { background: #fff; transform: none; }
  .cta-actions .btn:focus-visible { outline-color: var(--color-cream); }

  @media (max-width: 760px) {
    .page-hero { padding: 116px 0 44px; }
    .name-sec, .people-grid { grid-template-columns: minmax(0, 1fr); }
    .name-sec { gap: 30px; }
    .name-badge { width: 100%; max-width: 340px; margin-inline: auto; }
    .mat-cn { font-size: 3.8rem; }
  }
  @media (max-width: 520px) {
    .logo-row { grid-template-columns: minmax(0, 1fr); max-width: 320px; margin-inline: auto; gap: 16px; }
    .logo-card { padding: 24px; }
    .cta-actions { flex-direction: column; }
    .cta-actions .btn { justify-content: center; white-space: normal; }
    .about-cta { padding: 28px 24px; }
    .cta-actions .btn { padding-inline: 16px; }
  }
</style>
