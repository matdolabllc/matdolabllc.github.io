---
import Layout from "../layouts/Layout.astro";
import StoreBadges from "../components/StoreBadges.astro";

// Flip cards: front cartoon → back short how-to video of the real app.
const familyFlow = [
  { cartoon: "check-in",  label: "Check in",       video: "check-in" },
  { cartoon: "check-out", label: "Check out",      video: "check-out" },
  { cartoon: "reset",     label: "Reset check-in", video: "reset" },
];
const teamFlow = [
  { cartoon: "add-names",    label: "Add attendees",     video: "add-name" },
  { cartoon: "edit-profile", label: "Edit profile",      video: "edit-profile" },
  { cartoon: "upload",       label: "Import CSV",        video: "upload" },
  { cartoon: "export",       label: "Export CSV",        video: "export-csv" },
  { cartoon: "enroll",       label: "Enroll & unenroll", video: "enroll-unenroll" },
  { cartoon: "pin",          label: "Set PIN",           video: "set-pin" },
];

const useCases = [
  { t: "Tutoring centers", icon: "book" },
  { t: "Test prep & enrichment", icon: "sun" },
  { t: "Sunday schools", icon: "heart" },
  { t: "After-school programs", icon: "clock" },
  { t: "Music & art studios", icon: "music" },
  { t: "Clubs & sports", icon: "whistle" },
  { t: "Summer camps", icon: "tent" },
  { t: "Homeschool co-ops", icon: "users" },
];

const priceIncludes = [
  "Everything included — check-in, dashboard & CSV export",
  "Unlimited attendees and classes",
  "Your data stays on your device — always private",
  "Works offline, no accounts",
];

const ICONS: Record<string, string> = {
  book: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h6v16H6a2 2 0 0 0-2 2z"/><path d="M20 5a2 2 0 0 0-2-2h-6v16h6a2 2 0 0 1 2 2z"/></svg>',
  heart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.5-9.3-8.5C1 9 2.8 5.5 6.2 5.5c2 0 3.2 1.2 3.8 2.3.6-1.1 1.8-2.3 3.8-2.3 3.4 0 5.2 3.5 3.5 7C19 16.5 12 21 12 21z"/></svg>',
  sun: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
  music: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/></svg>',
  whistle: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="13" r="6"/><path d="M15 11h6a2 2 0 0 1 0 4h-2"/><path d="M9 7V4h4"/></svg>',
  tent: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3 20h18z"/><path d="M12 3v17"/><path d="m9 20 3-4 3 4"/></svg>',
  users: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5.5a3 3 0 0 1 0 5.5M15 20a6 6 0 0 0-1.5-4"/></svg>',
};
const ucIcon = (k: string) => ICONS[k] || "";
---
<Layout
  title="Matdo Check — Simple, reliable attendance check-in"
  description="Matdo Check is a simple, reliable check-in and attendance app for tutoring and enrichment centers, Sunday schools, clubs, and camps. 30-day free trial, then a $59.99 one-time license. No subscription; data stays on your device."
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-top">
      <div class="hero-copy">
        <h1 class="hero-title">Matdo Check</h1>
        <p class="hero-sub">Simple. Reliable. Easy setup. No subscription.</p>
        <p class="hero-lede">The calm way to check attendees in and out — for tutoring and enrichment centers, Sunday schools, clubs, and camps. On the tablet you already have.</p>
      </div>
      <div class="hero-actions">
        <StoreBadges class="hero-badges" vertical />
      </div>
    </div>
    <div class="wrap">
      <figure class="video-frame reveal">
        <video
          class="demo-video"
          poster="/demo/matdo-check-demo-poster.jpg"
          autoplay muted loop playsinline preload="auto"
          aria-label="Short animated overview of Matdo Check: an attendee checks in, does their work, and checks out; then the instructor dashboard and one-tap CSV export.">
          <source src="/demo/matdo-check-demo.webm" type="video/webm" />
          <source src="/demo/matdo-check-demo.mp4" type="video/mp4" />
          Your browser can't play embedded video — <a href="/demo/matdo-check-demo.mp4">watch it here</a>.
        </video>
      </figure>
    </div>
  </section>

  <!-- HOW IT WORKS — tap a cartoon to watch a how-to -->
  <section id="how" class="section-pad band-cream2">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Quick tutorials</span>
        <h2>Tap a card to watch how it's done.</h2>
        <p>Each one opens a short, slowed-down how-to from the real app.</p>
      </div>

      <div class="flow reveal">
        <div class="flow-lane">
          <span class="lane-tag family">At the front desk</span>
          <div class="tut-grid">
            {familyFlow.map((n) => (
              <button class="tut-card" data-video={n.video} data-title={n.label} aria-label={`Watch how to: ${n.label}`}>
                <span class="tut-art">
                  <img src={`/demo/cartoons/${n.cartoon}.svg`} alt="" width="240" height="190" />
                  <span class="tut-play" aria-hidden="true">▶</span>
                </span>
                <span class="tut-label">{n.label}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="flow-lane">
          <span class="lane-tag team">For your team</span>
          <div class="tut-grid">
            {teamFlow.map((n) => (
              <button class="tut-card" data-video={n.video} data-title={n.label} aria-label={`Watch how to: ${n.label}`}>
                <span class="tut-art">
                  <img src={`/demo/cartoons/${n.cartoon}.svg`} alt="" width="240" height="190" />
                  <span class="tut-play" aria-hidden="true">▶</span>
                </span>
                <span class="tut-label">{n.label}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tutorial lightbox -->
  <div id="tut-lb" class="tut-lb" hidden>
    <div class="tut-lb-scrim" data-close></div>
    <figure class="tut-lb-panel" role="dialog" aria-modal="true" aria-labelledby="tut-lb-title">
      <button class="tut-lb-close" data-close aria-label="Close tutorial">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" width="20" height="20"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <video id="tut-lb-video" class="tut-lb-video" muted loop playsinline></video>
      <figcaption id="tut-lb-title" class="tut-lb-title"></figcaption>
    </figure>
  </div>

  <!-- USE CASES -->
  <section class="section-pad">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Where it's used</span>
        <h2>Made for the places people gather to learn.</h2>
      </div>
      <div class="usecases reveal">
        {useCases.map((u) => (
          <div class="uc">
            <span class="uc-ic" set:html={ucIcon(u.icon)} />
            <span class="uc-t">{u.t}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="section-pad band-gold">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Pricing</span>
        <h2>One price. No surprises.</h2>
        <p>Try it free for a month. If you love it, buy it once — it's yours to keep.</p>
      </div>

      <div class="price-card reveal">
        <span class="trial-pill">30-day free trial</span>
        <div class="price">
          <span class="amt">$59.99</span>
          <span class="per">one&#8209;time license</span>
        </div>
        <p class="price-sub">Then it's yours. No subscription, no renewals, ever.</p>
        <ul class="price-list">
          {priceIncludes.map((f) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {f}
            </li>
          ))}
        </ul>
        <StoreBadges class="price-badges" />
        <p class="price-note">Start free — no card required. Buy once on the App Store or Google Play (coming soon).</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Tutorial lightbox: tap a cartoon → big, slowed how-to video. Tap it (or the
  // backdrop / ✕ / Esc) to close.
  const RATE = 0.7; // play slower so it's easy to follow
  const lb = document.getElementById("tut-lb");
  const lbVideo = document.getElementById("tut-lb-video") as HTMLVideoElement | null;
  const lbTitle = document.getElementById("tut-lb-title");

  function keepRate() { if (lbVideo) lbVideo.playbackRate = RATE; }

  function openTut(video: string, title: string) {
    if (!lb || !lbVideo) return;
    lbVideo.innerHTML = "";
    const webm = document.createElement("source"); webm.src = `/demo/tutorials/${video}.webm`; webm.type = "video/webm";
    const mp4 = document.createElement("source"); mp4.src = `/demo/tutorials/${video}.mp4`; mp4.type = "video/mp4";
    lbVideo.append(webm, mp4);
    if (lbTitle) lbTitle.textContent = title;
    lb.hidden = false;
    document.body.style.overflow = "hidden";
    lbVideo.load();
    lbVideo.currentTime = 0;
    keepRate();
    lbVideo.play().then(keepRate).catch(() => {});
  }

  function closeTut() {
    if (!lb || !lbVideo) return;
    lbVideo.pause();
    lb.hidden = true;
    document.body.style.overflow = "";
  }

  lbVideo?.addEventListener("loadeddata", keepRate);
  lbVideo?.addEventListener("play", keepRate);
  lbVideo?.addEventListener("click", closeTut);

  document.querySelectorAll<HTMLButtonElement>(".tut-card").forEach((card) => {
    card.addEventListener("click", () => openTut(card.dataset.video || "", card.dataset.title || ""));
  });
  lb?.querySelectorAll<HTMLElement>("[data-close]").forEach((el) => el.addEventListener("click", closeTut));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && lb && !lb.hidden) closeTut(); });

  // Nudge the hero video to autoplay (muted) and pause when off-screen.
  const heroVideo = document.querySelector<HTMLVideoElement>(".demo-video");
  if (heroVideo) {
    const play = () => heroVideo.play().catch(() => {});
    play();
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        (entries) => entries.forEach((e) => (e.isIntersecting ? play() : heroVideo.pause())),
        { threshold: 0.25 },
      ).observe(heroVideo);
    }
  }
</script>

<style>
  /* ── Hero (title left, download badges stacked at right) ── */
  .hero { padding: 140px 0 60px; }
  .hero-top { display: flex; align-items: center; justify-content: space-between; gap: 48px; }
  .hero-copy { text-align: left; }
  .hero-actions { flex: none; }
  /* stack the two download badges one on top of the other */
  .hero-actions :global(.store-badges) { flex-direction: column; flex-wrap: nowrap; align-items: stretch; gap: 14px; }
  .hero-title { font-size: clamp(3rem, 8vw, 5.5rem); line-height: 1; letter-spacing: -0.03em; }
  .hero-sub { font-family: var(--font-display); font-size: clamp(1.25rem, 3vw, 1.9rem); color: var(--color-teal); font-weight: 500; margin-top: 0.6rem; }
  .hero-lede { font-size: 1.15rem; color: #3d4b47; max-width: 38rem; margin-top: 1.1rem; }

  .video-frame { margin: 2.6rem auto 0; max-width: 1000px; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); border: 1px solid var(--color-line); background: var(--color-cream); }
  .demo-video { display: block; width: 100%; height: auto; }

  /* ── Flip-card flow ── */
  .flow { max-width: 1060px; margin: 0 auto; display: grid; gap: 22px; }
  .flow-lane { background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius-lg); padding: 20px 20px 24px; box-shadow: var(--shadow-sm); }
  .lane-tag { display: inline-block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; padding: 0.35rem 0.8rem; border-radius: 999px; margin-bottom: 14px; }
  .lane-tag.family { color: var(--color-teal); background: rgb(79 209 197 / 0.16); }
  .lane-tag.team { color: #a8843c; background: rgb(240 226 189 / 0.55); }
  .tut-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .tut-card { background: var(--color-cream); border: 2px solid var(--color-line); border-radius: var(--radius); padding: 16px 12px 18px; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 6px; transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; }
  .tut-card:hover { transform: translateY(-4px); border-color: var(--color-teal); box-shadow: 0 10px 26px rgb(31 111 99 / 0.14); }
  .tut-art { position: relative; width: 82%; display: block; }
  .tut-art img { display: block; width: 100%; height: auto; }
  .tut-play { position: absolute; inset: 0; margin: auto; width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; background: rgb(31 111 99 / 0.92); color: #fff; font-size: 0.9rem; padding-left: 3px; opacity: 0; transform: scale(0.8); transition: opacity 0.2s ease, transform 0.2s ease; box-shadow: 0 8px 22px rgb(0 0 0 / 0.22); }
  .tut-card:hover .tut-play { opacity: 1; transform: scale(1); }
  .tut-label { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--color-forest); }

  /* Lightbox */
  .tut-lb { position: fixed; inset: 0; z-index: 300; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .tut-lb[hidden] { display: none; }
  .tut-lb-scrim { position: absolute; inset: 0; background: rgb(18 28 25 / 0.62); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); animation: lbFade 0.25s ease; }
  .tut-lb-panel { position: relative; z-index: 1; margin: 0; display: flex; flex-direction: column; align-items: center; gap: 14px; animation: lbPop 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
  .tut-lb-video { display: block; width: min(760px, 92vw); height: auto; border-radius: 16px; box-shadow: 0 30px 80px rgb(0 0 0 / 0.4); border: 1px solid rgb(255 255 255 / 0.12); background: #0e1f1b; cursor: pointer; }
  .tut-lb-title { font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; color: #fff; text-align: center; }
  .tut-lb-close { position: absolute; top: -14px; right: -14px; width: 40px; height: 40px; border-radius: 50%; border: none; background: #fff; color: var(--color-ink); display: grid; place-items: center; cursor: pointer; box-shadow: var(--shadow-md); transition: transform 0.15s ease; }
  .tut-lb-close:hover { transform: scale(1.08); }
  @keyframes lbFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lbPop { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: none; } }

  /* ── Use cases ── */
  .usecases { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .uc { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; background: var(--color-cream); border: 1px solid var(--color-line); border-radius: var(--radius); padding: 28px 14px; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .uc:hover { transform: translateY(-4px); box-shadow: var(--shadow-sm); }
  .uc-ic { width: 44px; height: 44px; color: var(--color-teal); display: grid; place-items: center; }
  .uc-ic :global(svg) { width: 32px; height: 32px; }
  .uc-t { font-size: 0.95rem; font-weight: 600; color: var(--color-forest); line-height: 1.25; }

  /* ── Pricing ── */
  .price-card { max-width: 540px; margin: 0 auto; background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); padding: 40px 40px 34px; text-align: center; position: relative; }
  .trial-pill { display: inline-block; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-teal); background: rgb(79 209 197 / 0.16); padding: 0.5rem 1rem; border-radius: 999px; }
  .price { display: flex; align-items: baseline; justify-content: center; gap: 0.6rem; margin-top: 1.2rem; }
  .price .amt { font-family: var(--font-display); font-weight: 600; font-size: 4rem; line-height: 1; color: var(--color-ink); letter-spacing: -0.02em; }
  .price .per { font-size: 1rem; color: #8b968f; font-weight: 500; }
  .price-sub { color: #4a5854; margin-top: 0.6rem; }
  .price-list { list-style: none; padding: 0; margin: 1.8rem 0; display: grid; gap: 0.7rem; text-align: left; max-width: 22rem; margin-inline: auto; }
  .price-list li { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.98rem; color: var(--color-forest); }
  .price-list li svg { color: var(--color-teal); flex: none; margin-top: 2px; }
  .price-card :global(.price-badges) { justify-content: center; margin-top: 0.5rem; }
  .price-note { font-size: 0.8rem; color: #8b968f; margin-top: 1.2rem; }
  .price-note + .price-note { margin-top: 0.5rem; }
  .price-link { color: var(--color-teal); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 900px) {
    .hero { padding: 116px 0 44px; }
    .hero-top { flex-direction: column; align-items: flex-start; gap: 26px; }
    .hero-actions { align-self: stretch; }
    .usecases { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) {
    .tut-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 400px) {
    .tut-grid { grid-template-columns: 1fr; }
  }
</style>
