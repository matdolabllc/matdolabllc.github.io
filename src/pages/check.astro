---
import Layout from "../layouts/Layout.astro";
import ProductHero from "../components/ProductHero.astro";
import StoreBadges from "../components/StoreBadges.astro";
import { APP_STORE_URL } from "../consts";

// The tutorial clips keep the same filenames every time they're re-cut, so a
// returning visitor would be served the previous recording from cache. Bump
// this whenever the files under public/demo/tutorials/ are replaced.
const TUTORIAL_VERSION = "2026092202";

// Illustrated cards open the existing how-to videos of the real app.
//
// Each clip now opens with its own title sequence — the Matdo Check mark, the
// slogan, the tutorial's name, and the problem it answers — so the poster frame
// (`/demo/tutorials/<video>.jpg`) is a title card rather than a frame of iPad.
const setupFlow = [
  { cartoon: "first-run",   label: "Set up a new iPad",  video: "first-run" },
  { cartoon: "pin",         label: "Set PIN",            video: "set-pin" },
  { cartoon: "icloud",      label: "Back up to iCloud",  video: "icloud-backup" },
  { cartoon: "switch-ipad", label: "Move to a new iPad", video: "switch-ipad" },
];
const familyFlow = [
  { cartoon: "check-in",      label: "Check in",              video: "check-in" },
  { cartoon: "check-out",     label: "Check out",             video: "check-out" },
  { cartoon: "check-out-all", label: "Close up for the day",  video: "check-out-all" },
  { cartoon: "reset",         label: "Reset check-in",        video: "reset" },
];
const teamFlow = [
  { cartoon: "add-names",    label: "Add attendees",       video: "add-name" },
  { cartoon: "upload",       label: "Import CSV",          video: "upload" },
  { cartoon: "edit-profile", label: "Edit profile",        video: "edit-profile" },
  { cartoon: "enroll",       label: "Enroll & unenroll",   video: "enroll-unenroll" },
  { cartoon: "fix-time",     label: "Fix a time",          video: "fix-time" },
  { cartoon: "another-day",  label: "Look at another day", video: "another-day" },
  { cartoon: "export",       label: "Export CSV",          video: "export-csv" },
  { cartoon: "audit-log",    label: "The override log",    video: "audit-log" },
];

const tutorialGroups = [
  { id: "getting-started", title: "Getting started", description: "Set up your tablet, protect access, and keep a backup.", cards: setupFlow },
  { id: "front-desk", title: "At the front desk", description: "A smooth arrival, a simple goodbye, and a tidy end to the day.", cards: familyFlow },
  { id: "team-tools", title: "For your team", description: "Keep your roster, attendance records, and exports in order.", cards: teamFlow },
];

const useCases = [
  { t: "Tutoring centers", illustration: "tutoring" },
  { t: "Test prep & enrichment", illustration: "test-prep" },
  { t: "Sunday schools", illustration: "sunday-school" },
  { t: "After-school programs", illustration: "after-school" },
  { t: "Music & art studios", illustration: "music-art" },
  { t: "Clubs & sports", illustration: "clubs-sports" },
  { t: "Summer camps", illustration: "summer-camp" },
  { t: "Homeschool co-ops", illustration: "homeschool" },
];

const priceIncludes = [
  "Check-in, dashboard & CSV export",
  "Unlimited attendees and classes",
  "Your data stays on your device — always private",
  "Works offline, no accounts",
];

const plans = [
  {
    name: "Free Trial",
    amt: "$0",
    per: "for 7 days",
    sub: "No card required.",
    badge: "",
    featured: false,
  },
  {
    name: "Monthly",
    amt: "$2.99",
    per: "per month",
    sub: "Cancel anytime.",
    badge: "",
    featured: false,
  },
  {
    name: "Yearly",
    amt: "$24.99",
    per: "per year",
    sub: "Save 30% versus monthly.",
    badge: "Best value",
    featured: true,
  },
  {
    name: "Lifetime",
    amt: "$39.99",
    per: "one‑time",
    sub: "Pay once. Yours to keep, forever.",
    badge: "",
    featured: false,
  },
];

---
<Layout
  title="Matdo Check — Simple, reliable attendance check-in"
  description="Matdo Check is a simple, reliable check-in and attendance app for tutoring and enrichment centers, Sunday schools, clubs, and camps. 7-day free trial, then $2.99/month, $24.99/year, or a $39.99 lifetime license. Data stays on your device."
>
  <!-- HERO -->
<ProductHero name="Matdo Check" mark="/logos/matdo-check-mark.png" subtitle="Simple. Reliable. Easy setup." description="The calm way to check attendees in and out — for tutoring and enrichment centers, Sunday schools, clubs, and camps. On the tablet you already have.">
<StoreBadges slot="downloads" vertical />
<figure slot="video" class="video-frame reveal">
        <video
          class="demo-video"
          poster="/demo/matdo-check-film-poster.jpg"
          controls controlslist="nodownload"
          autoplay muted playsinline preload="auto"
          aria-label="Short film about Matdo Check: students arrive at a tutoring center, one checks in by name at the counter, works through the afternoon and checks out again; then the instructor answers four questions on her own panel — the class list, the change log, adding students, and exporting the year to CSV — and the film closes on privacy, pricing, and the App Store.">
          <source src="/demo/matdo-check-film.webm" type="video/webm" />
          <source src="/demo/matdo-check-film.mp4" type="video/mp4" />
          Your browser can't play embedded video — <a href="/demo/matdo-check-film.mp4">watch it here</a>.
        </video>
      </figure>
</ProductHero>

  <!-- HOW IT WORKS — illustrated cards open the how-to videos -->
  <section id="how" class="section-pad band-cream2">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Quick tutorials</span>
        <h2>A little guidance, every step of the way.</h2>
        <p>Each one is a step-by-step walk-through of the real app, captioned throughout.</p>
        <nav class="tutorial-nav" aria-label="Tutorial groups">
          {tutorialGroups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
        </nav>
      </div>

      <div class="flow">
        {tutorialGroups.map((group, i) => (
          <section id={group.id} class="flow-lane reveal" aria-labelledby={`${group.id}-title`}>
            <div class="lane-head">
              <span class="lane-number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 id={`${group.id}-title`}>{group.title}</h3>
                <p>{group.description}</p>
              </div>
            </div>
            <div class="tut-grid">
              {group.cards.map((n) => (
                <button type="button" class="tut-card" data-video={n.video} data-title={n.label} aria-label={`Watch how to: ${n.label}`}>
                  <span class="tut-art">
                    <img src={`/demo/check/tutorials/${n.cartoon}.webp`} alt="" width="512" height="512" loading="lazy" decoding="async" />
                  </span>
                  <span class="tut-label">{n.label}</span>
                  <span class="tut-hint" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="m10 8 6 4-6 4Z" fill="currentColor" stroke="none"/></svg>
                    Watch tutorial
                  </span>
                </button>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <!-- Tutorial lightbox -->
  <div id="tut-lb" class="tut-lb" data-v={TUTORIAL_VERSION} hidden>
    <div class="tut-lb-scrim" data-close></div>
    <figure class="tut-lb-panel" role="dialog" aria-modal="true" aria-labelledby="tut-lb-title">
      <button class="tut-lb-close" data-close aria-label="Close tutorial">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" width="20" height="20"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <video id="tut-lb-video" class="tut-lb-video" controls controlslist="nodownload" muted loop playsinline></video>
      <figcaption id="tut-lb-title" class="tut-lb-title"></figcaption>
    </figure>
  </div>

  <!-- USE CASES -->
  <section id="where" class="section-pad" aria-labelledby="where-title">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Where it's used</span>
        <h2 id="where-title">Made for the places people gather to learn.</h2>
      </div>
      <ul class="usecases reveal" role="list">
        {useCases.map((u) => (
          <li class="uc">
            <img src={`/demo/check/use-cases/${u.illustration}.webp`} alt="" width="512" height="512" loading="lazy" decoding="async" />
            <h3 class="uc-t">{u.t}</h3>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="section-pad band-gold">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Pricing</span>
        <h2>Simple pricing. Your choice.</h2>
        <p>Start with a free week. Then pick the plan that fits — subscribe, or pay once and keep it forever.</p>
      </div>

      <div class="price-grid reveal">
        {plans.map((p) => (
          <div class={"price-card" + (p.featured ? " featured" : "")}>
            {p.badge && <span class="plan-badge">{p.badge}</span>}
            <h3 class="plan-name">{p.name}</h3>
            <div class="price">
              <span class="amt">{p.amt}</span>
              <span class="per">{p.per}</span>
            </div>
            <p class="price-sub">{p.sub}</p>
          </div>
        ))}
      </div>

      <div class="price-includes reveal">
        <p class="includes-head">Every plan includes</p>
        <ul class="price-list">
          {priceIncludes.map((f) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {f}
            </li>
          ))}
        </ul>
        <StoreBadges class="price-badges" />
        <p class="price-note">Start free — no card required. <a href={APP_STORE_URL} rel="noopener">Download Matdo Check on the App Store</a>.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Tutorial lightbox: tap an illustrated card to open the how-to video.
  // The backdrop / ✕ / Esc close it (the video itself doesn't, so the play/scrub
  // bar stays usable).
  //
  // **Played at 1x.** These used to run at 0.7x because the old clips moved
  // faster than anyone could follow. The current set is captioned step by step
  // and already paced for normal speed — slowing it by a further 30% turned a
  // 93-second walk-through into a two-and-a-quarter-minute slideshow.
  const lb = document.getElementById("tut-lb");
  const lbVideo = document.getElementById("tut-lb-video") as HTMLVideoElement | null;
  const lbTitle = document.getElementById("tut-lb-title");

  let current = "";
  const verParam = () => (lb && lb.dataset.v ? `?v=${lb.dataset.v}` : "");

  // play() fired straight after load() gets aborted by the pending load, so also
  // start once the data is actually there.
  function playNow() {
    if (!lbVideo || !lb || lb.hidden) return;
    lbVideo.play().catch(() => {});
  }

  function openTut(video: string, title: string) {
    if (!lb || !lbVideo) return;
    current = video;
    lbVideo.removeAttribute("src");
    lbVideo.innerHTML = "";
    const v = verParam();
    const webm = document.createElement("source"); webm.src = `/demo/tutorials/${video}.webm${v}`; webm.type = "video/webm";
    const mp4 = document.createElement("source"); mp4.src = `/demo/tutorials/${video}.mp4${v}`; mp4.type = "video/mp4";
    lbVideo.append(webm, mp4);

    // The caption track. Deliberately NOT `default`: the captions are burnt
    // into the picture — the band is part of the composition, and a lightbox
    // that autoplays has nowhere sensible to turn a track on — so switching
    // this one on as well would show every line twice. It is here because it is
    // what makes those words reachable by a screen reader and by a search
    // engine, and it is one click away in the player's own captions menu.
    const vtt = document.createElement("track");
    vtt.kind = "captions";
    vtt.srclang = "en";
    vtt.label = "English";
    vtt.src = `/demo/tutorials/${video}.vtt${v}`;
    lbVideo.append(vtt);

    // The title card the clip opens on, so the panel is never a black rectangle
    // while the video loads.
    lbVideo.poster = `/demo/tutorials/${video}.jpg${v}`;

    if (lbTitle) lbTitle.textContent = title;
    lb.hidden = false;
    document.body.style.overflow = "hidden";
    lbVideo.load();
    lbVideo.currentTime = 0;
    playNow();
  }

  function closeTut() {
    if (!lb || !lbVideo) return;
    lbVideo.pause();
    lb.hidden = true;
    document.body.style.overflow = "";
  }

  // A <source> list only falls back when the browser rejects the *type*. If it
  // accepts the webm and then fails to decode it, playback dies silently — so
  // catch that and retry on the mp4.
  lbVideo?.addEventListener("error", () => {
    if (!lbVideo || !current || lbVideo.dataset.fallback === current) return;
    lbVideo.dataset.fallback = current;
    // Clearing the children drops the caption track along with the <source>
    // list, so it goes back on afterwards — the fallback path must not be the
    // one that quietly loses the captions.
    lbVideo.innerHTML = "";
    const vtt = document.createElement("track");
    vtt.kind = "captions";
    vtt.srclang = "en";
    vtt.label = "English";
    vtt.src = `/demo/tutorials/${current}.vtt${verParam()}`;
    lbVideo.append(vtt);
    lbVideo.src = `/demo/tutorials/${current}.mp4${verParam()}`;
    lbVideo.load();
    playNow();
  }, true);

  lbVideo?.addEventListener("loadeddata", playNow);
  lbVideo?.addEventListener("canplay", playNow);

  document.querySelectorAll<HTMLButtonElement>(".tut-card").forEach((card) => {
    card.addEventListener("click", () => openTut(card.dataset.video || "", card.dataset.title || ""));
  });
  lb?.querySelectorAll<HTMLElement>("[data-close]").forEach((el) => el.addEventListener("click", closeTut));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && lb && !lb.hidden) closeTut(); });

  // Nudge the hero video to autoplay (muted) and pause when off-screen — but
  // once someone works the controls, their choice wins: we stop auto-resuming.
  const heroVideo = document.querySelector<HTMLVideoElement>(".demo-video");
  if (heroVideo) {
    let userPaused = false;
    let auto = false;      // true while *we* are the ones pausing
    let inView = true;

    const play = () => {
      if (userPaused || !inView || heroVideo.ended) return;
      heroVideo.play().catch(() => {});
    };
    const autoPause = () => {
      if (heroVideo.paused) return;
      auto = true;
      heroVideo.pause();
    };

    // "pause" lands a tick later than pause(), so the flag is cleared here — by
    // the handler that consumes it — rather than straight after the call. A
    // browser pausing us because the tab went to the background isn't a choice
    // the visitor made either, so that doesn't count as a manual pause.
    heroVideo.addEventListener("pause", () => {
      if (auto) auto = false;
      else if (!document.hidden) userPaused = true;
    });
    heroVideo.addEventListener("play", () => { userPaused = false; });
    document.addEventListener("visibilitychange", () => { if (!document.hidden) play(); });

    play();
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            inView = e.isIntersecting;
            if (inView) play();
            else autoPause();
          }),
        { threshold: 0.25 },
      ).observe(heroVideo);
    }
  }
</script>

<style>
  /* Illustrated tutorial cards share Grade's palette and typography. */
  .tutorial-nav { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 24px; margin-top: 24px; }
  .tutorial-nav a { color: var(--color-teal); font-size: 0.9rem; font-weight: 600; text-decoration: underline; text-decoration-color: rgb(31 111 99 / 0.3); text-underline-offset: 5px; }
  .tutorial-nav a:hover { text-decoration-color: currentColor; }
  .flow { max-width: 1060px; margin: 0 auto; display: grid; gap: 48px; }
  .flow-lane { min-width: 0; scroll-margin-top: 112px; }
  .flow-lane + .flow-lane { border-top: 1px solid rgb(29 59 52 / 0.18); padding-top: 40px; }
  .lane-head { display: flex; align-items: baseline; gap: 16px; margin-bottom: 22px; }
  .lane-number { font-family: var(--font-display); font-size: 1.25rem; color: var(--color-teal); }
  .lane-head h3 { font-size: clamp(1.4rem, 2.5vw, 1.7rem); }
  .lane-head p { margin: 8px 0 0; font-size: 0.95rem; color: #4a5854; }
  .tut-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .tut-card { min-width: 0; font: inherit; text-align: center; background: #faf8ed; border: 2px solid var(--color-forest); border-radius: var(--radius); padding: 16px 16px 20px; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 6px; -webkit-tap-highlight-color: transparent; transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; }
  .tut-card:hover { transform: translateY(-4px); border-color: var(--color-teal); box-shadow: 0 10px 26px rgb(31 111 99 / 0.14); }
  .tut-card:focus-visible { outline: 3px solid var(--color-mint); outline-offset: 4px; border-radius: var(--radius); }
  .tut-art { width: min(100%, 220px); display: block; margin-bottom: 8px; }
  .tut-art img { display: block; width: 100%; height: auto; aspect-ratio: 1; border-radius: 12px; }
  .tut-label { display: flex; align-items: center; justify-content: center; min-height: 2.4em; font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; line-height: 1.2; text-wrap: balance; color: var(--color-forest); }
  .tut-hint { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 8px; font-size: 0.8rem; font-weight: 600; color: var(--color-teal); }
  .tut-hint svg { width: 16px; height: 16px; flex: none; }

  /* Lightbox */
  .tut-lb { position: fixed; inset: 0; z-index: 300; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .tut-lb[hidden] { display: none; }
  .tut-lb-scrim { position: absolute; inset: 0; background: rgb(18 28 25 / 0.62); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); animation: lbFade 0.25s ease; }
  .tut-lb-panel { position: relative; z-index: 1; margin: 0; display: flex; flex-direction: column; align-items: center; gap: 14px; animation: lbPop 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
  /* Tutorials are 4:3 iPad captures — cap by height too so the panel always fits the viewport */
  .tut-lb-video { display: block; aspect-ratio: 4 / 3; width: min(760px, 92vw, 72vh * 4 / 3); height: auto; border-radius: 16px; box-shadow: 0 30px 80px rgb(0 0 0 / 0.4); border: 1px solid rgb(255 255 255 / 0.12); background: #0e1f1b; }
  .tut-lb-title { font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; color: #fff; text-align: center; }
  .tut-lb-close { position: absolute; top: -14px; right: -14px; width: 40px; height: 40px; border-radius: 50%; border: none; background: #fff; color: var(--color-ink); display: grid; place-items: center; cursor: pointer; box-shadow: var(--shadow-md); transition: transform 0.15s ease; }
  .tut-lb-close:hover { transform: scale(1.08); }
  @keyframes lbFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lbPop { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: none; } }

  /* ── Use cases ── */
  #where { scroll-margin-top: 96px; }
  .usecases { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px 28px; list-style: none; margin: 0; padding: 24px 0; border-block: 1px solid var(--color-line); }
  .uc { min-width: 0; display: flex; align-items: center; gap: 14px; text-align: left; }
  .uc img { display: block; width: 80px; height: auto; aspect-ratio: 1; flex: none; border-radius: 12px; }
  .uc-t { min-width: 0; font-size: 1.1rem; font-weight: 600; color: var(--color-forest); line-height: 1.3; text-wrap: balance; }

  /* ── Pricing ── */
  .trial-pill { display: inline-block; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-teal); background: rgb(79 209 197 / 0.16); padding: 0.5rem 1rem; border-radius: 999px; margin-top: 1.2rem; }
  .price-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; align-items: stretch; margin: 0 auto; }
  .price-card { background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); padding: 30px 22px 28px; text-align: center; position: relative; display: flex; flex-direction: column; }
  .price-card.featured { border-color: var(--color-teal); box-shadow: 0 0 0 2px var(--color-teal), var(--shadow-lg); }
  .plan-badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; background: var(--color-teal); padding: 0.34rem 0.9rem; border-radius: 999px; }
  .plan-name { font-size: 1.05rem; font-weight: 700; color: var(--color-forest); margin: 0; letter-spacing: 0.01em; }
  .price { display: flex; align-items: baseline; justify-content: center; gap: 0.5rem; margin-top: 0.9rem; flex-wrap: wrap; }
  .price .amt { font-family: var(--font-display); font-weight: 600; font-size: 2.5rem; line-height: 1; color: var(--color-ink); letter-spacing: -0.02em; }
  .price .per { font-size: 0.95rem; color: #8b968f; font-weight: 500; }
  .price-sub { color: #4a5854; margin-top: 0.7rem; font-size: 0.95rem; }
  .price-includes { max-width: 540px; margin: 32px auto 0; text-align: center; }
  .includes-head { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #8b968f; }
  .price-list { list-style: none; padding: 0; margin: 1.2rem 0 1.8rem; display: grid; gap: 0.7rem; text-align: left; max-width: 22rem; margin-inline: auto; }
  .price-list li { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.98rem; color: var(--color-forest); }
  .price-list li svg { color: var(--color-teal); flex: none; margin-top: 2px; }
  .price-includes :global(.price-badges) { justify-content: center; margin-top: 0.5rem; }
  .price-note { font-size: 0.8rem; color: #8b968f; margin-top: 1.2rem; }
  .price-note a { color: var(--color-forest); text-decoration: underline; text-underline-offset: 2px; }
  .price-note + .price-note { margin-top: 0.5rem; }
  .price-link { color: var(--color-teal); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 900px) {
    .tut-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .usecases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .price-grid { grid-template-columns: repeat(2, 1fr); gap: 22px; max-width: 620px; }
  }
  @media (max-width: 620px) {
    .flow { gap: 32px; }
    .flow-lane + .flow-lane { padding-top: 28px; }
    .lane-head { gap: 12px; }
