---
import Layout from "../layouts/Layout.astro";
import ProductHero from "../components/ProductHero.astro";
import GradeBetaButton from "../components/GradeBetaButton.astro";
import GradeSubjects from "../components/GradeSubjects.astro";
import GradedSamples from "../components/GradedSamples.astro";
import GradeFeatures from "../components/GradeFeatures.astro";
import GradeWorkflow from "../components/GradeWorkflow.astro";
import GradeFAQ from "../components/GradeFAQ.astro";

// Matches the app (Plan.swift, MatdoGrade.storekit) and the server's free grant
// (server/src/lib/plans.js). Page counts are quoted at Brief, 10 units for a
// typical page (the middle of the 5 / 10 / 15 / 20 Brief bands the server bills
// by output tokens). Detailed is not quoted: it is the band plus 5 or 10, so
// 10–30 by page. A page the grader only reads costs 3.
const plans = [
  { name: "Lite", price: "$4.99", units: 750, for: "Parents helping one child" },
  { name: "Plus", price: "$9.99", units: 2000, for: "Tutoring several children" },
  { name: "Pro", price: "$19.99", units: 4500, for: "Teacher" },
  { name: "Max", price: "$39.99", units: 10000, for: "Busy Teacher" },
];
const fmt = (n: number) => n.toLocaleString("en-US");
---
<Layout
  schema={[{
    "@type": "SoftwareApplication",
    name: "Matdo Grade",
    description: "Photograph completed paper homework and review AI marks, correct answers, and explanations. No answer key needed.",
    applicationCategory: "EducationalApplication",
    operatingSystem: "iOS, iPadOS",
    url: "https://matdolab.com/grade/",
    publisher: { "@id": "https://matdolab.com/#organization" },
    offers: { "@type": "AggregateOffer", priceCurrency: "USD", lowPrice: "4.99", highPrice: "39.99", offerCount: plans.length },
  }]}
  title="Matdo Grade — Paper homework, graded on your iPhone or iPad"
  description="Photograph completed paper homework. Review marks, correct answers, and explanations with Matdo Grade on iPad and iPhone. No answer key needed."
>
  <!-- HERO -->
<ProductHero name="Matdo Grade" mark="/logos/matdo-grade-mark.png" headline={"Paper homework.\nGraded on your iPhone/iPad."} subtitle="For Parents. By Parents." description="Photograph your child’s finished homework. Review marks, correct answers, and explanations so you can help them try again." accent="#b08a3e">
<div slot="actions" class="grade-actions">
  <a class="btn btn-primary ga-example" href="#samples">See a graded example</a>
  <a class="btn btn-ghost ga-how" href="#how-grade-works">How it works</a>
  <!-- Early-access sign-up: on a wide screen it sits at the right end of this row,
       level with the buttons, with "Now in early access" above it and the note below. -->
  <p class="ga-soon">Now in early access</p>
  <GradeBetaButton class="ga-signup" />
  <p class="ga-note">Early-access families get 1,000 free units.</p>
  <ul class="grade-benefits" aria-label="Homework checking benefits">
    <li>No answer key to upload</li><li>No assignment to create</li><li>Feedback on your page</li>
  </ul>
</div>
<figure slot="video" class="video-frame reveal">
        <video class="demo-video" controls autoplay muted loop playsinline preload="metadata"
          width="1280" height="720" poster="/demo/matdo-grade-film-poster.jpg?v=20261004-v4"
          aria-label="Matdo Grade introduction film">
          <source src="/demo/matdo-grade-film.webm?v=20261004-v4" type="video/webm" />
          <source src="/demo/matdo-grade-film.mp4?v=20261004-v4" type="video/mp4" />
          <track kind="captions" src="/demo/matdo-grade-film.vtt?v=20261004-v4" srclang="en" label="English" />
          Your browser can't play embedded video — <a href="/demo/matdo-grade-film.mp4?v=20261004-v4">watch it here</a>.
        </video>
      </figure>
</ProductHero>

  <!-- On this page: a long page, so every section is one tap away. Sticks under the header. -->
  <nav class="grade-jump" aria-label="On this page">
    <div class="wrap">
      <a href="#samples">Examples</a>
      <a href="#how-grade-works">How it works</a>
      <a href="#subjects">Subjects</a>
      <a href="#features">Features</a>
      <a href="#pricing">Pricing</a>
      <a href="#grade-faq">FAQ</a>
      <a class="grade-jump-cta" href="/grade/try/">Join early access</a>
    </div>
  </nav>

  <!-- Actual grading results come before subject and feature descriptions. -->
  <GradedSamples />
  <GradeWorkflow />
  <GradeSubjects />

  <!-- FEATURES — tap a card to read its caption -->
  <GradeFeatures />

  <!-- PRICING -->
  <section id="pricing" class="section-pad pricing">
    <div class="wrap">
      <div class="sec-head center reveal">
        <h2>Pricing at launch</h2>
        <p class="pr-soon">For iPad and iPhone. Purchases open when Matdo Grade reaches the App Store.</p>
        <p class="pr-units-explain"><b>How units work:</b> each graded page uses units. A typical page takes about 10 units in <b>Brief</b> mode (marks, correct answers, and a short check of the working). <b>Detailed</b> mode adds a worked solution and where the working went wrong, for 5 or 10 more units a page.</p>
      </div>

      <div class="pr-grid reveal">
        <div class="pr-card free">
          <h3>Free</h3>
          <p class="pr-price">$0</p>
          <p class="pr-units"><b>100</b> units, one time</p>
          <p class="pr-pages">About 10 pages of Brief grading</p>
          <p class="pr-for">Free to start</p>
        </div>
        {plans.map((p) => (
          <div class="pr-card">
            <h3>{p.name}</h3>
            <p class="pr-price">{p.price}<span>/ month</span></p>
            <p class="pr-units"><b>{fmt(p.units)}</b> units a month</p>
            <p class="pr-pages">About {fmt(p.units / 10)} pages of Brief grading</p>
            <p class="pr-for">{p.for}</p>
          </div>
        ))}
      </div>

      <div class="pr-more reveal">
        <p><b>Top-Up:</b> 1,000 extra units for $6.99, never expire.</p>
        <p><b>Early access:</b> families who try Matdo Grade before launch get 1,000 free units. <a href="/grade/try/">Join early access</a>.</p>
      </div>
    </div>
  </section>
  <GradeFAQ />

  <!-- Closing action: the page ends with the one thing to do next. -->
  <section class="section-pad grade-end">
    <div class="wrap">
      <div class="grade-cta reveal">
        <h2>Try Matdo Grade before launch.</h2>
        <p>Early-access families get 1,000 free units, about 100 pages of Brief grading, on iPhone and iPad.</p>
        <GradeBetaButton />
      </div>
    </div>
  </section>
</Layout>

<style>
  .grade-actions { margin-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .grade-actions .btn { white-space: normal; text-align: center; justify-content: center; }
  .grade-benefits { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 8px 22px; list-style: none; padding: 0; margin: 0.5rem 0 0; font-size: 0.88rem; color: #4a5854; }
  .grade-benefits li::before { content: "✓"; margin-right: 7px; color: var(--color-teal); font-weight: 700; }
  .ga-soon { margin: 0; font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; line-height: 1.2; color: #b08a3e; }
  .ga-note { margin: 0; font-size: 0.9rem; color: #55665f; }

  /* Wide screens: the sign-up button shares a row with the two buttons and is
     centred on them; "Now in early access" hangs above it (absolutely placed in the
     same grid cell, so it takes no row height) and the note sits under it. */
  @media (min-width: 901px) {
    .grade-actions {
      position: relative; display: grid; column-gap: 12px; row-gap: 0;
      grid-template-columns: auto auto minmax(0, 1fr) auto;
      grid-template-areas: "ex how . signup" "ben ben ben note";
    }
    .ga-example { grid-area: ex; }
    .ga-how { grid-area: how; }
    .grade-actions :global(.ga-signup) { grid-area: signup; }
    .ga-soon { grid-area: signup; position: absolute; left: 0; bottom: 100%; margin-bottom: 0.7rem; }
    .ga-note { grid-area: note; align-self: start; margin-top: 0.8rem; }
    .grade-benefits { grid-area: ben; align-self: start; margin-top: 1.1rem; }
  }
  /* Narrow screens: the sign-up block first, since it is the one thing a
     visitor can do today, then the two buttons and the benefits. */
  @media (max-width: 900px) {
    .ga-soon { order: -3; flex-basis: 100%; }
    .grade-actions :global(.ga-signup) { order: -2; }
    .ga-note { order: -1; flex-basis: 100%; margin-bottom: 0.8rem; }
    .grade-benefits { order: 1; }
  }
  @media (max-width: 760px) { .grade-benefits { display: grid; gap: 8px; } }



  /* On-this-page links */
  .grade-jump { position: sticky; top: 84px; z-index: 50; background: rgb(250 248 241 / 0.94); backdrop-filter: blur(8px); border-block: 1px solid var(--color-line); }
  .grade-jump .wrap { display: flex; align-items: center; gap: 4px; overflow-x: auto; scrollbar-width: none; padding-block: 8px; }
  .grade-jump .wrap::-webkit-scrollbar { display: none; }
  .grade-jump a { flex: none; padding: 8px 14px; border-radius: 999px; font-size: 0.9rem; font-weight: 600; color: #3d4b47; white-space: nowrap; }
  .grade-jump a:hover { background: var(--color-cream2); color: var(--color-forest); }
  .grade-jump .grade-jump-cta { margin-left: auto; background: #1a2422; color: #fff; }
  .grade-jump .grade-jump-cta:hover { background: var(--color-forest); color: #fff; }
  /* Closing call to action */
  .grade-end { padding-top: 0; }
  .grade-cta { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; padding: clamp(32px, 6vw, 56px); border-radius: 16px; background: var(--color-cream2); }
  .grade-cta h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .grade-cta p { max-width: 34rem; color: #4a5854; margin-bottom: 8px; }
  @media (max-width: 760px) { .grade-jump { top: 74px; } .grade-jump .grade-jump-cta { margin-left: 8px; } }

  .pr-soon { margin-top: 0.4rem; }
  .pr-units-explain { max-width: 44rem; margin: 1rem auto 0; padding: 14px 18px; border-radius: 12px; background: var(--color-cream2); font-size: 0.95rem; line-height: 1.55; color: #3d4b47; text-align: left; }
  .pr-units-explain b { color: var(--color-forest); }
  .pr-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  .pr-card {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: 22px 20px; background: #fff; border: 1px solid var(--color-line);
    border-radius: var(--radius); box-shadow: var(--shadow-sm);
  }
  .pr-card.free { background: var(--color-cream2); box-shadow: none; }
  .pr-card h3 { font-size: 1.25rem; }
  .pr-price { margin: 0.2rem 0 0.3rem; font-family: var(--font-display); font-size: 2rem; font-weight: 600; line-height: 1.1; color: var(--color-forest); }
  .pr-price span { margin-left: 0.25rem; font-family: var(--font-sans); font-size: 0.85rem; font-weight: 500; color: #6b7772; }
  .pr-units { margin: 0; font-size: 0.95rem; color: var(--color-ink); }
  .pr-pages { margin: 0; font-size: 0.84rem; line-height: 1.4; color: #4a5854; }
  .pr-for { margin: auto 0 0; padding-top: 0.8rem; border-top: 1px solid var(--color-line); font-size: 0.84rem; font-weight: 600; color: var(--color-teal); }
  .pr-more { max-width: 46rem; margin: 2.2rem auto 0; text-align: center; color: #4a5854; }
  .pr-more p { margin: 0.35rem 0; }
  .pr-more b { color: var(--color-forest); }
  .pr-more a { color: var(--color-teal); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .pr-more .pr-fine { font-size: 0.82rem; color: #8b968f; }
  .pr-more :global(.pr-badge) { margin-top: 1.4rem; }
  @media (max-width: 1080px) { .pr-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .pr-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; max-width: 420px; margin-inline: auto; }
    .pr-card { padding: 22px; }
    .pr-price { font-size: 2rem; }
  }




</style>
