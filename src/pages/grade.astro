---
import Layout from "../layouts/Layout.astro";
import AppStoreSoon from "../components/AppStoreSoon.astro";
import GradeSubjects from "../components/GradeSubjects.astro";
import GradedSamples from "../components/GradedSamples.astro";
import GradeFeatures from "../components/GradeFeatures.astro";

// Matches the app (Plan.swift, MatdoGrade.storekit) and the server's free grant
// (server/src/lib/plans.js). Page counts are quoted at Brief, 10 units for a
// typical page. Detailed is deliberately not quoted: the server bills it at a
// flat 30 today, and PRICING_PROPOSAL.md's token bands would make it 10–30 by
// page. A page the grader only reads costs 5.
const plans = [
  { name: "Lite", price: "$4.99", units: 750, for: "Parents helping one child" },
  { name: "Plus", price: "$9.99", units: 2000, for: "Tutoring several children" },
  { name: "Pro", price: "$19.99", units: 4500, for: "Teacher" },
  { name: "Max", price: "$39.99", units: 10000, for: "Busy Teacher" },
];
const fmt = (n: number) => n.toLocaleString("en-US");
---
<Layout
  title="Matdo Grade — AI homework grading on iPad, with you in control"
  description="Matdo Grade is an iPad app that scans handwritten homework and grades it with AI in seconds — while the teacher reviews, overrides, and stays fully in control."
>
  <!-- HERO -->
  <section class="page-hero">
    <div class="wrap ph-grid">
      <div>
        <img class="hero-mark" src="/logos/matdo-grade-mark.png" width="552" height="782" alt="" />
        <h1 class="hero-title">Matdo Grade</h1>
        <p class="hero-sub">For parents, tutors, teachers</p>
        <p class="lede">Use AI to help your children and students by scanning their handwritten homework and providing instant feedback.</p>
      </div>

      <div class="hero-actions"><AppStoreSoon /></div>
    </div>
  </section>

  <section class="film-section" aria-label="Matdo Grade introduction video">
    <div class="wrap">
      <figure class="video-frame reveal">
        <video class="demo-video" controls autoplay muted loop playsinline preload="auto"
          width="1280" height="720" poster="/demo/matdo-grade-film-poster.jpg"
          aria-label="Matdo Grade introduction film">
          <source src="/demo/matdo-grade-film.webm" type="video/webm" />
          <source src="/demo/matdo-grade-film.mp4" type="video/mp4" />
          Your browser can't play embedded video — <a href="/demo/matdo-grade-film.mp4">watch it here</a>.
        </video>
      </figure>
    </div>
  </section>

  <GradeSubjects />

  <!-- SEE IT GRADE -->
  <GradedSamples />

  <!-- FEATURES — tap a card to read its caption -->
  <GradeFeatures />

  <!-- PRICING -->
  <section id="pricing" class="section-pad pricing">
    <div class="wrap">
      <div class="sec-head center reveal">
        <h2>Pricing</h2>
        <p class="pr-soon">For iPad and iPhone.</p>
      </div>

      <div class="pr-grid reveal">
        <div class="pr-card free">
          <h3>Free</h3>
          <p class="pr-price">$0</p>
          <p class="pr-units"><b>100</b> units, one time</p>
          <p class="pr-pages">About 10 pages of Brief grading</p>
          <p class="pr-for">Free trial</p>
        </div>
        {plans.map((p) => (
          <div class="pr-card">
            <h3>{p.name}</h3>
            <p class="pr-price">{p.price}<span>/ month</span></p>
            <p class="pr-units"><b>{fmt(p.units)}</b> units a month</p>
            <p class="pr-pages">About {fmt(p.units / 10)} pages of Brief grading</p>
            <p class="pr-for">{p.for}</p>
          </div>
        ))}
      </div>

      <div class="pr-more reveal">
        <p><b>Top-Up:</b> 1,000 extra units for $6.99, never expire.</p>
        <p class="pr-fine">Prices in US dollars — the App Store shows your local price. Plans renew monthly and can be cancelled anytime in your Apple account settings.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .film-section { padding: 24px 0 clamp(40px, 6vw, 72px); }
  .video-frame { margin: 2rem auto 0; max-width: 1000px; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); border: 1px solid var(--color-line); background: var(--color-cream); }
  .demo-video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  .page-hero { padding: 150px 0 clamp(28px, 4vw, 44px); }
  .hero-mark { display: block; height: 88px; width: auto; margin-bottom: 1.1rem; }
  .ph-grid { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 56px; align-items: center; }
  .ph-grid > * { min-width: 0; }
  .page-hero .wrap { position: relative; }
  /* Top right of the page, level with the Matdo Grade mark. */
  .page-hero :global(.hero-store) { position: absolute; top: 0; right: 24px; z-index: 2; }

  .pr-soon { margin-top: 0.4rem; }
  .pr-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  .pr-card {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: 22px 20px; background: #fff; border: 1px solid var(--color-line);
    border-radius: var(--radius); box-shadow: var(--shadow-sm);
  }
  .pr-card.free { background: var(--color-cream2); box-shadow: none; }
  .pr-card h3 { font-size: 1.25rem; }
  .pr-price { margin: 0.2rem 0 0.3rem; font-family: var(--font-display); font-size: 2rem; font-weight: 600; line-height: 1.1; color: var(--color-forest); }
  .pr-price span { margin-left: 0.25rem; font-family: var(--font-sans); font-size: 0.85rem; font-weight: 500; color: #6b7772; }
  .pr-units { margin: 0; font-size: 0.95rem; color: var(--color-ink); }
  .pr-pages { margin: 0; font-size: 0.84rem; line-height: 1.4; color: #4a5854; }
  .pr-for { margin: auto 0 0; padding-top: 0.8rem; border-top: 1px solid var(--color-line); font-size: 0.84rem; font-weight: 600; color: var(--color-teal); }
  .pr-more { max-width: 46rem; margin: 2.2rem auto 0; text-align: center; color: #4a5854; }
  .pr-more p { margin: 0.35rem 0; }
  .pr-more b { color: var(--color-forest); }
  .pr-more .pr-fine { font-size: 0.82rem; color: #8b968f; }
  .pr-more :global(.pr-badge) { margin-top: 1.4rem; }
  @media (max-width: 1080px) { .pr-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .pr-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
    .pr-card { padding: 18px 16px; }
    .pr-price { font-size: 1.6rem; }
  }
  /* Title and subtitle set as on the Matdo Check page, the subtitle in Grade's gold. */
  .hero-title { font-size: clamp(3rem, 8vw, 5.5rem); line-height: 1; letter-spacing: -0.03em; }
  .hero-sub { font-family: var(--font-display); font-size: clamp(1.25rem, 3vw, 1.9rem); color: #b08a3e; font-weight: 500; line-height: 1.25; margin: 0.6rem 0 0; }
  .page-hero .lede { font-size: 1.15rem; color: #3d4b47; max-width: 34rem; margin: 1.1rem 0 0; }
  .hero-actions { align-self: start; justify-self: end; padding-top: 100px; }


  @media (max-width: 900px) {
    .page-hero { padding: 120px 0 28px; }
    .hero-mark { height: 70px; margin-bottom: 0.9rem; }
    .ph-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-actions { justify-self: start; padding-top: 0; }
  }
</style>
